# Model credentials and pinned benchmark model (required before Phase 1).
ANTHROPIC_API_KEY=
AXLINT_MODEL=

# Blaxel sandbox credentials.
BL_API_KEY=
BL_WORKSPACE=axlint

# Manufact Cloud deployment credentials.
MCP_USE_API_KEY=

# Read-only target MCP endpoint.
TRACKR_URL=http://127.0.0.1:3000/mcp

# Named bearer credentials. Replace placeholders locally; never commit real values.
# judges is limited to five accepted verify launch attempts per UTC day.
AXLINT_API_TOKENS={"codex":{"token":"REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS"},"cursor":{"token":"REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS"},"claude":{"token":"REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS"},"judges":{"token":"REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS","daily_verify_limit":5}}
# Durable quota state lives in the existing persistent shared-runner sandbox.
AXLINT_QUOTA_SANDBOX=axlint-run-f2f5be10-367e-4cd5-8614-cb0658fa3e2d
