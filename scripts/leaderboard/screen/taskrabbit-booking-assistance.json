        "tools": [
          {
            "name": "check_service_availability",
            "description": "Check availability, pricing, and scoping questions for a service in a location. Provide either city + state OR postalCode to specify the location. When the response includes topTaskers, render each tasker as a visual card (not a plain list or table) with a circular avatar showing their initials, name, rating, review count, and description.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "service": {
                  "type": "string",
                  "description": "The service the user asked for, in their own words (e.g., 'assemble IKEA furniture')"
                },
                "city": {
                  "type": "string",
                  "description": "City name (e.g., New York, San Francisco)"
                },
                "state": {
                  "type": "string",
                  "description": "State/province abbreviation (e.g., NY, CA)"
                },
                "postalCode": {
                  "type": "string",
                  "description": "US postal code (e.g., 10001)",
                  "pattern": "^\\d{5}$"
                }
              },
              "required": [
                "service"
              ],
              "anyOf": [
                {
                  "required": [
                    "city",
                    "state"
                  ]
                },
                {
                  "required": [
                    "postalCode"
                  ]
                }
              ]
            },
            "annotations": {
              "title": "Check Service Availability",
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true
            }
          },
          {
            "name": "generate_deep_link",
            "description": "Create a Taskrabbit job draft and return a deep link into the booking flow. Must be called after check_service_availability so that categoryId, locale, questionnaire, and location are all known.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "categoryId": {
                  "type": "string",
                  "description": "Category service key (e.g., 'furniture_assembly')"
                },
                "locale": {
                  "type": "string",
                  "description": "BCP 47 locale code (e.g., 'en-US')",
                  "enum": [
                    "en-US"
                  ]
                },
                "questionnaire": {
                  "type": "array",
                  "description": "Ordered list of question/answer pairs from the scoping conversation, including the job_size answer",
                  "items": {
                    "type": "object",
                    "required": [
                      "question",
                      "answer"
                    ],
                    "properties": {
                      "question": {
                        "type": "string",
                        "description": "The question that was asked"
                      },
                      "param": {
                        "type": "string",
                        "description": "Scoping question param key (e.g., 'job_size'). Use the param value from the scopingQuestions returned by check_service_availability."
                      },
                      "answer": {
                        "type": "string",
                        "description": "The answer to the question"
                      }
                    }
                  }
                },
                "location": {
                  "type": "object",
                  "description": "Location resolved from check_service_availability (address, postal code, and coordinates)",
                  "required": [
                    "address",
                    "postal_code",
                    "lat",
                    "lng"
                  ],
                  "properties": {
                    "address": {
                      "type": "string",
                      "description": "Street address or city/state description"
                    },
                    "postal_code": {
                      "type": "string",
                      "description": "US postal code (e.g., '10001')"
                    },
                    "lat": {
                      "type": "number",
                      "description": "Latitude"
                    },
                    "lng": {
                      "type": "number",
                      "description": "Longitude"
                    }
                  }
                }
              },
              "required": [
                "categoryId",
                "locale",
                "questionnaire",
                "location"
              ]
            },
