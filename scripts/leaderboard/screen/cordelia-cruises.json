    "instructions": "Cordelia Cruises assistant. Use search_knowledge to answer questions about policies, inclusions, ships and FAQs. Use search_sailings to find cruises by destination, origin, month, nights or budget — each result includes a booking_url. When the guest picks a sailing, give them the booking_url (or call get_booking_link) so they can continue on cordeliacruises.com. Booking and payment are completed on the website, not in chat.",
    "pages": [
      {
        "tools": [
          {
            "name": "search_knowledge",
            "title": "Search Cordelia knowledge base",
            "description": "Search the Cordelia Cruises knowledge base for policies, FAQs, inclusions, ship info, dining, activities, embarkation and cancellation details. Use for any general cruise question.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "description": "The guest question or search query"
                },
                "ship": {
                  "type": "string",
                  "description": "Optional ship name filter, e.g. \"Empress\""
                },
                "locale": {
                  "type": "string",
                  "enum": [
                    "en",
                    "hi",
                    "hinglish"
                  ],
                  "description": "Response locale (default en)"
                }
              },
              "required": [
                "query"
              ]
            },
            "annotations": {
              "title": "Search Cordelia knowledge base",
              "readOnlyHint": true,
              "openWorldHint": true
            }
          },
          {
            "name": "search_sailings",
            "title": "Search cruise sailings",
            "description": "Search available Cordelia cruise itineraries by destination, origin, month, nights, trip type or budget. Each result includes a booking_url that opens the sailing on cordeliacruises.com.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "destination": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Destination port names, e.g. [\"Goa\"]"
                },
                "origin": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Departure port names, e.g. [\"Mumbai\"]"
                },
                "monthYear": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Months as MM-YYYY, e.g. [\"01-2027\"] — only if the guest names a month"
                },
                "nightCount": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "Number of nights, e.g. [3] or [2,3]"
                },
                "tripType": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "\"round\" or \"one_way\""
                },
                "startingPrice": {
                  "type": "number",
                  "description": "Explicit minimum budget only"
                },
                "maximumPrice": {
                  "type": "number",
                  "description": "Explicit maximum budget only"
                }
              }
            },
            "annotations": {
              "title": "Search cruise sailings",
              "readOnlyHint": true,
              "openWorldHint": true
            },
            "_meta": {
              "ui": {
                "resourceUri": "ui://cordelia/sailings-card.html"
              },
              "openai/outputTemplate": "ui://cordelia/sailings-card.html"
            }
          },
          {
            "name": "get_itinerary_details",
            "title": "Get full itinerary details",
            "description": "Get complete details for a specific cruise itinerary: route, ship, dates, fare, the port-by-port plan, and the shore excursions available at each port (with descriptions). Use when the guest asks to know more about a particular sailing, its ports, or what to do on shore. Pass the itinerary_id from a search_sailings result.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "itinerary_id": {
                  "type": "string",
                  "description": "The itinerary_id from a search_sailings result"
                }
              },
              "required": [
                "itinerary_id"
              ]
            },
            "annotations": {
              "title": "Get full itinerary details",
              "readOnlyHint": true,
              "openWorldHint": true
            },
            "_meta": {
              "ui": {
                "resourceUri": "ui://cordelia/itinerary-detail.html"
              },
              "openai/outputTemplate": "ui://cordelia/itinerary-detail.html"
            }
          },
          {
            "name": "get_booking_link",
            "title": "Get booking link for a sailing",
            "description": "Return the cordeliacruises.com link for a specific itinerary so the guest can continue booking. Use page=\"selectcabin\" when they are ready to choose a cabin and book, otherwise \"itinerary\".",
            "inputSchema": {
              "type": "object",
              "properties": {
                "itinerary_id": {
                  "type": "string",
                  "description": "The itinerary_id from a search_sailings result"
                },
                "page": {
                  "type": "string",
                  "enum": [
                    "itinerary",
                    "selectcabin"
                  ],
                  "description": "Which booking page to link to (default itinerary)"
                }
              },
              "required": [
                "itinerary_id"
              ]
            },
            "annotations": {
              "title": "Get booking link for a sailing",
              "readOnlyHint": true,
              "openWorldHint": true
            }
          },
