        "tools": [
          {
            "name": "search_archive_imagery",
            "description": "Find actual orderable satellite imagery scenes for a location and date range, with real per-scene prices. This is the right tool for any question about what imagery is AVAILABLE or how much it COSTS to order existing scenes. Returns per-scene results with capture date, product, resolution, cloud cover, and the exact cost to buy that scene. Supports advanced mode parameter: \"search\" (default, top 50 results), \"time_series\" (best image per year/quarter/month — set interval and wide date range), \"compare_providers\" (best per provider), \"budget\" (free and cheapest options). Show each result individually. If 0 results: increase max_cloud_cover, expand date range, or increase radius_km.",
            "annotations": {
              "title": "Search Archive Imagery",
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true
            },
            "inputSchema": {
              "type": "object",
              "properties": {
                "location_query": {
                  "type": "string",
                  "description": "Natural language location (e.g., \"San Francisco\", \"downtown Toronto\")"
                },
                "radius_km": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 1000,
                  "default": 10,
                  "description": "Search radius in km. Default 10km. Use 25-100km for geographic features."
                },
                "coordinates": {
                  "type": "object",
                  "properties": {
                    "lat": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "lon": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "radius_km": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 1000,
                      "default": 10
                    }
                  },
                  "required": [
                    "lat",
                    "lon"
                  ]
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "Bounding box [west, south, east, north]"
                },
                "geojson": {
                  "type": "object",
                  "description": "GeoJSON geometry for search area",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "Polygon",
                        "Point"
                      ]
                    },
                    "coordinates": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "type",
                    "coordinates"
                  ]
                },
                "start_date": {
                  "type": "string",
                  "description": "Start date (ISO 8601 or natural language like \"6 months ago\"). Defaults to 6 months ago."
                },
                "end_date": {
                  "type": "string",
                  "description": "End date (ISO 8601 or natural language like \"today\"). Defaults to today."
                },
                "max_cloud_cover": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "default": 50,
                  "description": "Maximum cloud cover %. Default 50%. Use 20% for clear-sky, 100% to see everything."
                },
                "min_coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Minimum area coverage percentage required."
                },
                "resolution_preference": {
                  "type": "string",
                  "enum": [
                    "any",
                    "low",
                    "medium",
                    "high",
                    "very_high"
                  ],
                  "description": "Resolution tier: low (8-30m), medium (1.26-8m), high (0.5-1.25m), very_high (<0.5m)"
                },
                "data_type": {
                  "type": "string",
                  "enum": [
                    "all",
                    "satellite",
                    "optical",
                    "aerial",
                    "elevation",
                    "sar",
                    "basemaps"
                  ],
                  "default": "all",
                  "description": "Data type filter"
                },
                "order_by": {
                  "type": "string",
                  "enum": [
                    "date",
                    "resolution",
                    "coverage",
                    "cost"
                  ],
                  "default": "date",
                  "description": "Sort results by field"
                },
                "limit": {
                  "type": "number",
                  "default": 15,
                  "maximum": 50,
                  "description": "Maximum number of results to return"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "search",
                    "time_series",
                    "compare_providers",
                    "budget"
                  ],
                  "default": "search",
                  "description": "Search mode. \"search\" = standard results. \"time_series\" = one best image per time period. \"compare_providers\" = best per provider. \"budget\" = free and cheapest options."
                },
                "interval": {
                  "type": "string",
                  "enum": [
                    "yearly",
                    "quarterly",
                    "monthly"
                  ],
                  "default": "yearly",
                  "description": "Time interval for time_series mode. \"yearly\", \"quarterly\", or \"monthly\"."
                }
              }
            }
