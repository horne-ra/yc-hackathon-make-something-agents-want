            "name": "calculate-pregnancy-week",
            "title": "Calculate pregnancy week",
            "description": "Calculate the current pregnancy week, due date, trimester, and baby's fruit-size comparison from the last menstrual period or a known due date, and display it on an interactive pregnancy wheel",
            "inputSchema": {
              "type": "object",
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "properties": {
                "lastPeriodDate": {
                  "description": "First day of the last menstrual period, in YYYY-MM-DD format. Provide this or dueDate.",
                  "type": "string"
                },
                "dueDate": {
                  "description": "Estimated due date, in YYYY-MM-DD format. Provide this or lastPeriodDate.",
                  "type": "string"
                },
                "cycleLength": {
                  "description": "Average menstrual cycle length in days, used to refine the due date (default 28)",
                  "type": "number",
                  "minimum": 20,
                  "maximum": 45
                }
              }
            },
            "annotations": {
              "title": "Calculate pregnancy week",
              "readOnlyHint": true,
              "destructiveHint": false,
              "openWorldHint": false
            },
