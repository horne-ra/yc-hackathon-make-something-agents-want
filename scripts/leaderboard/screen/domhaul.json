              "openai/widgetAccessible": true,
              "openai/toolInvocation/invoking": "Checking domain availability…",
              "openai/toolInvocation/invoked": "Checked domain availability"
            },
            "outputSchema": {
              "$schema": "http://json-schema.org/draft-07/schema#",
              "type": "object",
              "properties": {
                "summary": {
