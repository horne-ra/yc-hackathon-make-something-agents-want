          {
            "name": "edit_wiki_node",
            "title": "Edit Wiki Node",
            "description": "Apply a small exact old_text to new_text replacement to one wiki node body, then commit the change to the product Git repo. Use only after read_wiki_nodes provides the exact editable_content.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "description": "Product UUID returned by read_wiki_nodes or get_product_tree."
                },
                "node_id": {
                  "type": "string",
                  "description": "Node ID returned by get_product_tree."
                },
                "old_text": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact text copied from read_wiki_nodes editable_content. Must match the node body exactly."
                },
                "new_text": {
                  "type": "string",
                  "description": "Replacement text. Can be empty to remove old_text."
                },
                "replace_all": {
                  "type": "boolean",
                  "description": "Replace every exact occurrence. Defaults to false; when false, old_text must appear exactly once."
                },
                "change_summary": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Brief reason for the change, including debugging or discovery context if known."
                }
              },
              "required": [
                "product_id",
                "node_id",
                "old_text",
                "new_text",
                "change_summary"
              ],
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "description": "Result of applying and committing an exact replacement to one wiki node body.",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "description": "Whether the edit and commit completed successfully."
                },
                "product_id": {
                  "type": "string",
                  "description": "Product UUID that was edited."
                },
                "node_id": {
                  "type": "string",
                  "description": "Knowledge node id that was edited."
                },
                "path": {
                  "type": "string",
                  "description": "Git file path that was edited."
                },
                "branch": {
                  "type": "string",
                  "description": "Git branch that received the commit."
                },
                "parent_commit_id": {
                  "type": "string",
                  "description": "Git parent commit used for stale-write protection."
                },
                "commit_id": {
                  "type": "string",
                  "description": "Git commit id created for this edit."
                },
                "commit_sha": {
                  "type": "string",
                  "description": "Alias of commit_id for older clients."
                },
                "commit_url": {
                  "type": "string",
                  "description": "Tenant dashboard URL for the edited product."
                },
                "replacements": {
                  "type": "integer",
                  "description": "Number of exact old_text occurrences replaced."
                }
              },
              "required": [
                "ok",
                "product_id",
                "node_id",
                "path",
                "branch",
                "parent_commit_id",
                "commit_id",
                "commit_sha",
                "commit_url",
                "replacements"
              ],
              "additionalProperties": true
            },
            "securitySchemes": [
              {
                "type": "oauth2",
                "scopes": [
                  "email",
                  "offline_access",
                  "openid",
                  "profile"
                ]
              }
            ],
            "annotations": {
              "readOnlyHint": false,
              "destructiveHint": true,
              "idempotentHint": false,
              "openWorldHint": false
            }
          }
        ]
      }
