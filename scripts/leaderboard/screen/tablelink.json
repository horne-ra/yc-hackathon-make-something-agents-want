          {
            "name": "get_availability",
            "title": "Check TableLink reservation availability",
            "description": "Get open reservation time slots for a TableLink restaurant on a given date and party size. Identify the restaurant by tenantId (from search_restaurants) or by slug. Dates are YYYY-MM-DD in the restaurant's local timezone. Returns the open time slots, or a reason if none.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "tenantId": {
                  "type": "string",
                  "description": "Restaurant tenantId from search_restaurants (preferred)."
                },
                "slug": {
                  "type": "string",
                  "description": "Restaurant slug, e.g. \"ember-oak\" (alternative to tenantId)."
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "Date as YYYY-MM-DD in the restaurant's timezone."
                },
                "partySize": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50,
                  "description": "Number of guests (1-50)."
                }
              },
              "required": [
                "date",
                "partySize"
              ],
              "additionalProperties": false,
              "$schema": "http://json-schema.org/draft-07/schema#"
            },
            "annotations": {
              "readOnlyHint": true,
              "openWorldHint": true,
              "destructiveHint": false
            },
            "execution": {
              "taskSupport": "forbidden"
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "found": {
                  "type": "boolean",
                  "description": "Whether the restaurant was resolved."
                },
                "tenantId": {
                  "type": "string",
                  "description": "Resolved restaurant tenantId."
                },
                "restaurantName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "date": {
                  "type": "string",
                  "description": "Requested date, YYYY-MM-DD."
                },
                "partySize": {
                  "type": "number"
                },
                "timezone": {
                  "type": "string",
                  "description": "Restaurant IANA timezone."
                },
                "available": {
                  "type": "boolean",
                  "description": "Whether any open slots exist for the date/party."
                },
                "slots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "time": {
                        "type": "string",
                        "description": "Slot start, HH:MM 24-hour in restaurant time. Use this when calling book_reservation."
                      },
                      "displayTime": {
                        "type": "string",
                        "description": "Slot start formatted for humans as \"h:MM AM/PM\". Use this when narrating to the user — never paste the 24-hour `time` field in user-facing text."
                      },
                      "availableTables": {
                        "type": "number"
                      },
                      "combinedTables": {
                        "type": "boolean",
                        "description": "Whether the slot requires combining tables."
                      }
                    },
                    "required": [
                      "time",
                      "availableTables",
                      "combinedTables"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Open time slots (empty when none)."
                },
                "message": {
                  "type": "string",
                  "description": "Reason when no slots / booking unavailable."
                },
                "bookingDisabled": {
                  "type": "boolean"
                },
                "hours": {
                  "description": "Operating hours for the date, if open."
                }
              },
              "required": [
                "found",
                "tenantId",
                "date",
                "partySize",
                "timezone",
                "available",
                "slots"
              ],
              "additionalProperties": false,
              "$schema": "http://json-schema.org/draft-07/schema#"
            }
          },
          {
            "name": "book_reservation",
            "title": "Book a TableLink reservation",
            "description": "Book a reservation at a TableLink restaurant on behalf of the authenticated user. Identify the restaurant by slug (from search_restaurants). Returns reservationId + confirmationToken, plus two URLs the diner can use: cancelUrl (one-click cancel) and manageUrl (the diner's TableLink dashboard listing all their reservations). To cancel via this tool instead, pass the confirmationToken to cancel_reservation. Name, phone, AND email are all required — collect the email before booking.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "restaurantSlug": {
                  "type": "string",
                  "description": "Restaurant slug from search_restaurants, e.g. \"the-copper-lantern\"."
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "YYYY-MM-DD in the restaurant's local timezone."
                },
                "time": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "description": "HH:MM 24-hour in the restaurant's local timezone, e.g. \"19:30\"."
                },
                "partySize": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "customerName": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 80,
                  "description": "Diner's name as it should appear on the reservation."
                },
                "customerPhone": {
                  "type": "string",
                  "description": "E.164 phone number, e.g. \"+13105551234\"."
                },
                "customerEmail": {
                  "type": "string",
                  "format": "email",
                  "description": "Diner's email — REQUIRED. The confirmation and reminders are sent here; ask the user for it before booking."
                },
                "specialRequests": {
                  "type": "string",
                  "maxLength": 500,
                  "description": "Any notes for the restaurant (allergies, accessibility, seating preference)."
                },
                "occasion": {
                  "type": "string",
                  "enum": [
                    "Birthday",
                    "Anniversary",
                    "Date",
                    "Business",
                    "Celebration",
                    "Other"
                  ]
                },
                "smsOptIn": {
                  "type": "boolean",
                  "default": true,
                  "description": "Receive SMS confirmation + reminders. Defaults to true."
                },
                "confirmDuplicate": {
                  "type": "boolean",
                  "description": "Set true ONLY to override the same-date duplicate-booking guardrail. Leave false (the default) for the first attempt. If booking_create returns a duplicate-booking error, ask the user whether they really want a second reservation that day, and if they confirm, retry with confirmDuplicate: true."
                }
              },
              "required": [
                "restaurantSlug",
                "date",
                "time",
                "partySize",
                "customerName",
                "customerPhone",
                "customerEmail"
              ],
              "additionalProperties": false,
              "$schema": "http://json-schema.org/draft-07/schema#"
            },
            "annotations": {
              "readOnlyHint": false,
              "openWorldHint": true,
              "destructiveHint": false
            },
            "execution": {
              "taskSupport": "forbidden"
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "reservationId": {
                  "type": "string"
                },
                "confirmationToken": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "time": {
                  "type": "string"
                },
                "partySize": {
                  "type": "number"
                },
                "restaurantName": {
                  "type": "string"
                },
                "tableName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "cancelUrl": {
                  "type": "string",
                  "description": "Public one-click cancel URL for this reservation. Loading it cancels. When you tell the user about this, render it as a short clickable link with the label \"Cancel\" (markdown: [Cancel](url)) — do NOT paste the raw URL as visible text."
                },
                "manageUrl": {
                  "type": "string",
                  "description": "Diner's TableLink dashboard listing every reservation tied to their account. Requires sign-in (same Apple/Google/email used to connect). When you tell the user about this, render it as a short clickable link with the label \"Manage reservations\" (markdown: [Manage reservations](url)) — do NOT paste the raw URL as visible text."
                }
              },
              "required": [
                "reservationId",
                "confirmationToken",
                "date",
                "time",
                "partySize",
                "restaurantName",
                "cancelUrl",
                "manageUrl"
              ],
              "additionalProperties": false,
              "$schema": "http://json-schema.org/draft-07/schema#"
            }
          },
