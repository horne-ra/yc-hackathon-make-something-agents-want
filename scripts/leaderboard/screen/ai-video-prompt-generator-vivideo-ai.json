    "instructions": "Builds structured text prompts for AI video systems. Call list_video_prompt_styles to see the available styles and their ids, then call build_video_prompt with the concept and an optional style_id. This server returns text only: it does not generate video, images, or audio, does not access any account, and stores nothing.",
    "pages": [
      {
        "tools": [
          {
            "name": "build_video_prompt",
            "title": "Build an AI video prompt",
            "description": "Converts a video concept and optional production choices into a structured, model-agnostic text prompt for an AI video system. Returns prompt text, a negative prompt, and normalized generation settings. It generates text only; it does not create media, access accounts, or save data.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "idea": {
                  "type": "string",
                  "description": "The video concept in a sentence or two. Name the subject, what it does, and where.",
                  "minLength": 10,
                  "maxLength": 2000
                },
                "style_id": {
                  "type": "string",
                  "description": "Optional style id from list_video_prompt_styles. Supplies camera, lighting, visual style and mood defaults. An unrecognized id is ignored and noted in the result.",
                  "maxLength": 64
                },
                "generation_mode": {
                  "type": "string",
                  "description": "text_to_video builds a scene from nothing; image_to_video animates an existing image and preserves its subject. Defaults to text_to_video.",
                  "enum": [
                    "text_to_video",
                    "image_to_video"
                  ]
                },
                "destination": {
                  "type": "string",
                  "description": "Where the clip will be published. Affects composition and aspect ratio only. Defaults to general.",
                  "enum": [
                    "general",
                    "tiktok",
                    "instagram_reels",
                    "youtube_shorts",
                    "youtube",
                    "advertisement"
                  ]
                },
                "aspect_ratio": {
                  "type": "string",
                  "description": "Frame shape. Defaults to 9:16 for tiktok, instagram_reels and youtube_shorts, otherwise 16:9.",
                  "enum": [
                    "16:9",
                    "9:16",
                    "1:1"
                  ]
                },
                "duration_seconds": {
                  "type": "integer",
                  "description": "Intended clip length in whole seconds. Defaults to 8.",
                  "minimum": 1,
                  "maximum": 120
                },
                "subject": {
                  "type": "string",
                  "description": "Who or what is on screen, if the idea should be sharpened.",
                  "maxLength": 300
                },
                "action": {
                  "type": "string",
                  "description": "The single main thing happening. One clear action works best.",
                  "maxLength": 300
                },
                "setting": {
                  "type": "string",
                  "description": "Location plus time of day or weather.",
                  "maxLength": 300
                },
                "camera": {
                  "type": "string",
                  "description": "Shot size and camera movement, for example \"low tracking shot\".",
                  "maxLength": 300
                },
                "lighting": {
                  "type": "string",
                  "description": "Light source and quality, for example \"neon reflections on wet streets\".",
                  "maxLength": 300
                },
                "visual_style": {
                  "type": "string",
                  "description": "Medium, look and grade, for example \"cinematic 35mm\".",
                  "maxLength": 300
                },
                "mood": {
                  "type": "string",
                  "description": "Emotional tone of the shot.",
                  "maxLength": 300
                },
                "composition": {
                  "type": "string",
                  "description": "Explicit framing instruction, overriding the aspect-ratio default.",
                  "maxLength": 300
                },
                "motion_strength": {
                  "type": "string",
                  "description": "How much movement to ask for. Defaults to balanced, or subtle for image_to_video.",
                  "enum": [
                    "subtle",
                    "balanced",
                    "dynamic"
                  ]
                },
                "avoid": {
                  "type": "array",
                  "description": "Things to exclude, added to the standard negative prompt. Plain terms such as \"brand logos\".",
                  "items": {
                    "type": "string",
                    "maxLength": 100
