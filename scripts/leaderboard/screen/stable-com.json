            "annotations": {
              "destructiveHint": false,
              "openWorldHint": false,
              "readOnlyHint": true
            },
            "description": "Computes a swap quote for a (assetFrom, chainFrom) → (assetTo, chainTo) pair. Returns amountFrom and amountTo, the min and max amounts accepted, the source pool balance, and the fees: executionFeeUSD, amlFeeUSD, and nativeFeeUsd (the separate native-token gas fee, which is absent when gasLess is true). There is no exchange-rate field — derive it from amountFrom and amountTo if needed. Read-only — does not execute any transaction.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "assetFrom": {
                  "type": "string",
                  "description": "the source asset symbol, e.g. USDT"
                },
                "chainFrom": {
                  "type": "string",
                  "description": "the source chain id, e.g. 101"
                },
                "assetTo": {
                  "type": "string",
                  "description": "the destination asset symbol"
                },
                "chainTo": {
                  "type": "string",
                  "description": "the destination chain id"
                },
                "amountFrom": {
                  "type": "string",
                  "description": "the source amount as a decimal string"
                },
                "amountTo": {
                  "type": "string",
                  "description": "the destination amount as a decimal string (alternative to amountFrom)"
                },
                "addressFrom": {
                  "type": "string",
                  "description": "optional sender address on the source chain. Only affects accuracy: when given, gas is estimated against that account's actual on-chain state instead of a default, refining executionFeeUSD. Omit it if the user has not provided an address — the quote works without it"
                },
                "addressTo": {
                  "type": "string",
                  "description": "optional recipient address on the destination chain. Only affects accuracy, in the same way as addressFrom. Omit it if the user has not provided an address"
                },
                "gasLess": {
                  "type": "boolean",
                  "description": "if true, executionFee is paid in the swap asset and reduces amountTo; if false, the user pays a separate native-token gas fee and amountTo equals amountFrom"
                }
              },
              "required": [
                "assetFrom",
                "chainFrom",
                "assetTo",
                "chainTo"
              ],
              "additionalProperties": false
            },
            "name": "swap_get_quote",
            "outputSchema": {
              "type": "object",
              "properties": {
                "amountFrom": {
                  "type": "string"
                },
                "amountTo": {
                  "type": "string"
                },
                "assetFrom": {
                  "type": "string"
                },
                "assetTo": {
                  "type": "string"
                },
                "min": {
                  "type": "string"
                },
                "max": {
                  "type": "string"
                },
                "balance": {
                  "type": "string"
                },
                "executionFeeUSD": {
                  "type": "string"
                },
                "nativeFeeUsd": {
                  "type": "string"
                },
                "amlFeeUSD": {
                  "type": "string"
                }
              },
              "required": [
                "amountFrom",
                "amountTo"
              ],
              "additionalProperties": false
            },
            "title": "Get swap quote"
          },
          {
            "annotations": {
              "destructiveHint": false,
