            },
            "description": "Returns the status of a cross-chain swap identified by its secretHash. Transaction id fields are included only for the stages the swap has actually reached — a refund id, for example, appears only if the swap was refunded. Read-only.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "secretHash": {
                  "type": "string",
                  "description": "the secretHash identifying a cross-chain swap the user already started on Stable, hex-encoded; the 0x prefix is optional and stripped automatically"
                }
              },
              "required": [
                "secretHash"
              ],
              "additionalProperties": false
            },
            "name": "swap_get_crosschain_status",
            "outputSchema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "sourceLockTransactionId": {
                  "type": "string"
                },
                "destinationLockTransactionId": {
                  "type": "string"
                },
                "destinationClaimTransactionId": {
                  "type": "string"
                },
                "sourceRefundTransactionId": {
                  "type": "string"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            },
            "title": "Get cross-chain swap status"
          },
          {
            "_meta": {
              "openai/outputTemplate": "ui://widget/swap-quote.html",
              "ui": {
                "csp": {
                  "redirectDomains": [
