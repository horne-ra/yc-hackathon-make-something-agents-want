            },
            "description": "Returns native and token balances for the given (chainId, address) pairs. chainId values come from swap_get_config (e.g. \"101\" for Ethereum), not standard EVM chain IDs. Note that the response is keyed by lowercase chain NAME (\"ethereum\", \"bsc\"), not by the chainId that was passed in. Chains with no balance are omitted, as is the tokens list when no token has a non-zero balance; chains that could not be read are listed in failedChains with partial set to true. Read-only.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "accounts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chainId": {
                        "type": "string",
                        "description": "the chain id from swap_get_config (e.g. 101 for Ethereum), NOT a standard EVM chain id"
                      },
                      "address": {
                        "type": "string",
                        "description": "the wallet address on that chain"
                      }
                    },
                    "required": [
                      "chainId",
                      "address"
                    ],
                    "additionalProperties": false
                  },
                  "description": "one entry per wallet to query; repeat the entry to query the same address on several chains"
                }
              },
              "required": [
                "accounts"
              ],
              "additionalProperties": false
            },
            "name": "account_get_balances",
            "outputSchema": {
              "type": "object",
              "properties": {
                "chains": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "nativeBalance": {
                        "type": "string"
                      },
                      "tokens": {
                        "type": [
                          "null",
                          "array"
                        ],
                        "items": {
                          "type": "object",
                          "properties": {
                            "asset": {
                              "type": "string"
                            },
                            "balance": {
                              "type": "string"
                            }
                          },
                          "required": [
