    "instructions": "This service uses its own internal chain identifiers, NOT standard EVM chain IDs. Always call swap_get_config first to discover the supported chainId values (for example Ethereum is \"101\", not \"1\") and asset symbols, then pass those exact chainId strings to the other tools (account_get_balances, account_get_allowances, swap_get_quote, swap_get_crosschain_status, etc.). Never assume standard chain IDs. All tools are read-only and never sign transactions or change on-chain state.",
    "pages": [
      {
        "tools": [
          {
            "annotations": {
              "destructiveHint": false,
              "openWorldHint": true,
              "readOnlyHint": true
            },
            "description": "Returns the Permit2 and LiquidityPool allowances for the given (chainId, address, token) tuples. chainId values come from swap_get_config (e.g. \"101\" for Ethereum), not standard EVM chain IDs. token is an asset symbol such as USDT; each result echoes it back as token and also reports the underlying contract as tokenAddress. Allowances are returned as human-readable decimal amounts. A per-result error field is set when a single chain could not be read. Useful for telling the user whether an approve is required before swapping. Read-only.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "queries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chainId": {
                        "type": "string",
                        "description": "the chain id from swap_get_config (e.g. 101 for Ethereum), NOT a standard EVM chain id"
                      },
                      "address": {
                        "type": "string",
                        "description": "the wallet address to check allowances for"
                      },
                      "token": {
                        "type": "string",
                        "description": "optional token symbol; if empty, returns all tokens for chain+address"
                      }
                    },
                    "required": [
                      "chainId",
                      "address"
                    ],
                    "additionalProperties": false
                  },
                  "description": "one entry per (chainId, address, token) tuple to look up; returns Permit2 and LiquidityPool allowances"
                }
              },
              "required": [
                "queries"
              ],
              "additionalProperties": false
            },
            "name": "account_get_allowances",
            "outputSchema": {
              "type": "object",
              "properties": {
                "results": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "chainId": {
                        "type": "string"
                      },
                      "address": {
                        "type": "string"
                      },
                      "token": {
                        "type": "string"
                      },
                      "tokenAddress": {
                        "type": "string"
                      },
                      "allowancePool": {
                        "type": "string"
                      },
                      "allowancePermit2": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "chainId",
                      "address",
                      "token"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "results"
              ],
              "additionalProperties": false
            },
            "title": "Get ERC-20 allowances"
          },
