            "description": "Checks whether the destination (or source-gasless) lock for a given secretHash exists and is valid on-chain. Read-only.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "secretHash": {
                  "type": "string",
                  "description": "the secretHash of the swap to validate, hex-encoded; the 0x prefix is optional and stripped automatically"
                },
                "type": {
                  "type": "string",
                  "description": "the lock side to validate; allowed values: lockDestination or lockSourceGasless",
                  "enum": [
                    "lockDestination",
                    "lockSourceGasless"
                  ]
                }
              },
              "required": [
                "secretHash",
                "type"
              ],
              "additionalProperties": false
            },
            "name": "swap_validate_lock",
            "outputSchema": {
              "type": "object",
              "properties": {
                "valid": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                },
                "secretHash": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "chain": {
                  "type": "string"
                },
                "recipient": {
                  "type": "string"
                },
                "lockTime": {
                  "type": "integer"
                },
                "deadline": {
                  "type": "string"
                }
              },
              "required": [
                "valid"
              ],
              "additionalProperties": false
            },
            "title": "Validate cross-chain lock"
          }
        ]
      }
