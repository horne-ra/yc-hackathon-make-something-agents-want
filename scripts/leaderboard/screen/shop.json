          {
            "name": "search",
            "title": "Search Shop Products",
            "description": "\n  Search for products on Shop.app. Use this when the user wants to:\n    - search for products\n    - find items\n    - look for things to buy\n    - discover products\n    - browse products.\n\n  Returns a list of product results with images, prices, and shop information.\n\n  For normal searches, omit personalized_results. The host's connected Shop account is\n  used automatically when credentials are supplied; otherwise results are public.\n  Connected users do not need to request account access for each search.\n  Set personalized_results=true only when the requested task needs personalized\n  results from the shopper's Shop account.\n  Set personalized_results=false for an explicit public search without account context.\n  Leave sign-in, refresh, and connection prompts to the host. Do not suggest\n  signing in merely because a search returns public results.\n",
            "inputSchema": {
              "type": "object",
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "properties": {
                "query": {
                  "type": "string",
                  "description": "Product search query"
                },
                "personalized_results": {
                  "description": "Omit for normal searches: automatically use supplied account credentials, or search publicly without credentials. Set true only when the task requires personalized results from the Shop account, or false to search publicly without account context.",
