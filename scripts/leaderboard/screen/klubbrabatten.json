    "instructions": "Use find_discounts for current public Klubbrabatten discounts and estimate_savings for a non-binding saving estimate. The live catalog is the source of truth for discount, coupon quantity and eligible stores. When the user names a Swedish city, municipality or region, pass it in the separate location argument (not in query); an unknown location returns no offers and should be reported as such, never replaced by another city. These tools are read-only previews: never claim to redeem a coupon, reveal a redemption code, create an account or complete a purchase. An active booklet in the Klubbrabatten app is required for redemption.",
    "pages": [
      {
        "tools": [
          {
            "name": "find_discounts",
            "title": "Hitta aktuella Klubbrabatten-rabatter",
            "description": "Search Klubbrabatten's live public catalog of Swedish local discounts by merchant, category or product, optionally limited to one Swedish city, municipality or region. Returns the exact current discount, coupon terms, branded coupon images, coupon quantity and the eligible stores in that location; online-only offers that are valid everywhere are listed after local ones. When a location is given but not found in the catalog, no offers are returned and locationSource is 'unrecognized'. It only previews offers and never redeems a coupon.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "Merchant, category or product, for example 'Stadium', 'pizza' or 'gym'. Leave the place out; use location for that. Omit to list popular offers."
                },
                "location": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "Swedish city, municipality or region the user asked about, for example 'Uppsala', 'Västerås' or 'Dalarna'. Matched strictly against the catalog's locations; results are only from this place (plus online offers valid everywhere)."
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6,
                  "description": "Maximum number of offers to return, 1–6. Defaults to 6."
                }
