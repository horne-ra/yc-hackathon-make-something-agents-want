    "instructions": "WoopDrive is a car rental marketplace. Use list_destinations to see which cities have cars, search_cars to find available vehicles in a city for given dates, and get_car_details for one vehicle. All data is read-only. To book, send the user the returned woopdrive.com deep link; the booking, identity verification, insurance and payment are completed on the WoopDrive site, not through this tool.",
    "pages": [
      {
        "tools": [
          {
            "name": "list_destinations",
            "title": "List WoopDrive destinations",
            "description": "Return the cities where WoopDrive currently has bookable cars, with the number of available vehicles per city and the country. Use the returned `city` value as input to search_cars.",
            "inputSchema": {
              "$schema": "http://json-schema.org/draft-07/schema#",
              "type": "object",
              "properties": {}
            },
            "annotations": {
              "readOnlyHint": true,
              "openWorldHint": true
            },
            "execution": {
              "taskSupport": "forbidden"
            }
          },
          {
            "name": "search_cars",
            "title": "Search available cars in a city",
            "description": "Find bookable cars in a given city, optionally filtered by rental dates and pickup/return times. Dates are ISO YYYY-MM-DD; times are HH:MM (24h). Returns vehicle cards with daily rate in EUR, total for the date range when dates are supplied, transmission, key features, and the supplier. Each result includes a vehicle_id for get_car_details and a deep link to the search page on woopdrive.com.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string",
                  "minLength": 1,
                  "description": "City name, e.g. 'Larnaca', 'Crete', 'Malta'. Use a value returned by list_destinations."
                },
                "from": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "Pickup date, ISO YYYY-MM-DD."
                },
                "to": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "Return date, ISO YYYY-MM-DD."
                },
                "pickup_time": {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$",
                  "description": "Pickup time HH:MM (24h)."
                },
                "return_time": {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$",
                  "description": "Return time HH:MM (24h)."
                },
                "locale": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 5,
                  "description": "UI locale for the deep link, e.g. 'en', 'lt', 'pl'. Default 'en'."
                }
              },
              "required": [
                "city"
              ],
              "additionalProperties": false,
              "$schema": "http://json-schema.org/draft-07/schema#"
            },
            "annotations": {
              "readOnlyHint": true,
              "openWorldHint": true
            },
            "execution": {
              "taskSupport": "forbidden"
            }
          },
          {
            "name": "get_car_details",
            "title": "Get details for one car",
            "description": "Return full details for a single vehicle by its vehicle_id (24-char hex id from search_cars): specs, full feature list, daily rate and total for the date range when dates are supplied, min/max rental days, and availability. Includes a vehicle deep link and a prefilled checkout deep link on woopdrive.com. Booking, KYC, insurance and payment happen on the site, not here.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "vehicle_id": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{24}$",
                  "description": "24-char hex vehicle id from search_cars."
                },
                "from": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "Pickup date, ISO YYYY-MM-DD."
                },
                "to": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "Return date, ISO YYYY-MM-DD."
                },
                "pickup_time": {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$",
                  "description": "Pickup time HH:MM (24h)."
                },
                "return_time": {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$",
                  "description": "Return time HH:MM (24h)."
                },
                "locale": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 5,
                  "description": "UI locale for the deep links, e.g. 'en', 'lt', 'pl'. Default 'en'."
                }
              },
              "required": [
                "vehicle_id"
              ],
              "additionalProperties": false,
