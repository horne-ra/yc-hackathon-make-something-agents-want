    "pages": [
      {
        "tools": [
          {
            "name": "get_charging_locations_radius",
            "title": "Find EV charging locations nearby",
            "description": "Find EV charging locations within a fixed ~1 degree box around a latitude/longitude point, with optional filters for network, connector type, charging level, power, price, and amenities. Results are sorted closest-to-farthest from the given point, each annotated with DistanceKm and DetailsUrl (a link to the location's page on chargehub.com).",
            "inputSchema": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90,
                  "description": "Latitude of the centre point"
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180,
                  "description": "Longitude of the centre point"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000,
                  "description": "Max locations to return (default 250, max 2000). Applied upstream before distance sorting, so a low limit may exclude nearer locations."
                },
                "remove_networks": {
                  "type": "string",
                  "description": "Comma-separated network codes to exclude"
                },
                "remove_levels": {
                  "type": "string",
                  "description": "Comma-separated charging levels to exclude: 1, 2, 3"
                },
                "remove_connectors": {
                  "type": "string",
                  "description": "Comma-separated connector IDs to exclude"
                },
                "above_power": {
                  "type": "number",
                  "description": "Minimum port power in kW"
                },
                "only_247": {
                  "type": "boolean",
                  "description": "Only return locations with 24/7 public access"
                },
                "free": {
                  "type": "boolean",
                  "description": "Only return locations with free charging"
                },
                "hotel": {
                  "type": "boolean",
                  "description": "Only return hotel/lodging locations (cannot combine with amenities)"
                },
                "amenities": {
                  "type": "string",
                  "description": "Comma-separated amenity tags (cannot combine with hotel)"
                },
                "only_passport": {
                  "type": "boolean",
                  "description": "Only return Passport-enabled locations"
                },
                "show_pending": {
                  "type": "boolean",
                  "description": "Include pending/under-construction ports"
                },
                "language": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fr"
                  ],
                  "description": "Response language, default en"
                }
              },
              "required": [
                "lat",
                "lon"
              ],
              "additionalProperties": false,
              "$schema": "http://json-schema.org/draft-07/schema#"
            },
            "annotations": {
              "title": "Find EV charging locations nearby",
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": true
            },
            "execution": {
              "taskSupport": "forbidden"
            }
          },
          {
            "name": "get_charging_location_details",
            "title": "Get EV charging location details",
            "description": "Get the full detail record for a single EV charging station: address, connectors, per-port status, pricing, and access info, plus DetailsUrl (a link to the location's page on chargehub.com).",
            "inputSchema": {
              "type": "object",
              "properties": {
                "station_id": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "description": "Unique numeric identifier of the charging location, as returned in the LocID field of get_charging_locations_radius results"
                },
                "language": {
                  "type": "string",
                  "enum": [
                    "en",
