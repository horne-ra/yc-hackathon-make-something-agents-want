          {
            "name": "get_charging_networks",
            "title": "List EV charging networks",
            "description": "List the public EV charging networks, each with its numeric ID (the network code), Name, and IconUrl (logo link, or null for networks with no logo). Use it to turn a network name into the code that get_charging_locations_radius filters on. That filter is remove_networks — an exclusion list — so to see only one network, pass the IDs of every other network; to hide a network, pass just its ID. Returns an empty list if ChargeHub has no networks to report.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string",
                  "enum": [
                    "en",
                    "fr"
                  ],
                  "description": "Response language, default en"
                }
