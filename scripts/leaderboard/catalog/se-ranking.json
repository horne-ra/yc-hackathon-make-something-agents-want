  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add SE Ranking to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add SE Ranking to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.seranking.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the SE Ranking MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SE Ranking lists 217 MCP tools, including DATA_createAdvancedAudit, DATA_createStandardAudit, DATA_deleteAudit, DATA_exportBacklinksData, DATA_getAiSearchBrand, DATA_getAiSearchLeaderboard, DATA_getAiSearchOverview, DATA_getAiSearchPromptsByBrand, DATA_getAiSearchPromptsByTarget, DATA_getAllBacklinks, DATA_getAuditHistory, and DATA_getAuditPagesByIssue."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to SE Ranking?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to SE Ranking in marketing-seo on the Manufact MCP catalog include Buzzfy, Airefs AI Visibility, TalkGenAI, RankControl, and attentive-mcp-server."
      }
    },
    {
      "@type": "Question",
      "name": "Does SE Ranking MCP require authentication?",
