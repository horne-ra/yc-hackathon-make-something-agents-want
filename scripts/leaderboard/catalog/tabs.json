  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Tabs to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Tabs to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://integrators.prod.api.tabsplatform.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Tabs MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tabs lists 27 MCP tools, including commitments_get, commitments_list, contracts_billing_term_groups_get, contracts_get, contracts_list, contracts_performance_obligations_get, contracts_usage_get, credit_memos_by_invoice, credit_memos_get, credit_memos_list, customers_contacts_list, and customers_get."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Tabs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Tabs in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does Tabs MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tabs requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
