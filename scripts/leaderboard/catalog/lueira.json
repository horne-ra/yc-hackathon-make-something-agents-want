  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Lueira to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Lueira to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.lueira.com/api/v1/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Lueira MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lueira lists 84 MCP tools, including add_shop_stock_level, create_customer, create_group_lesson_order, create_order, create_order_item, create_private_lesson_order, create_rental_order, create_shop_order, delete_customer, delete_group_lesson_order, delete_order, and delete_order_item."
      }
    },
    {
