  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Riido to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Riido to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.riido.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Riido MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Riido lists 53 MCP tools, including add_backlog, add_backlog_label, add_backlog_section, add_component, add_component_comment, add_component_label, add_component_member, archive_component, convert_backlog_to_component, delete_backlog, delete_backlog_label, and delete_backlog_section."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Riido?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Riido in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Riido MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Riido requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Riido?",
      "acceptedAnswer": {
