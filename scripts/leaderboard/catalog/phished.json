  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Phished to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Phished to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.phished.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Phished MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Phished lists 96 MCP tools, including create-administrator, create-allow-block-list-entry, create-button-response, create-department, create-domain, create-email-branding-template, create-landing-page, create-location, create-recipient, create-simulation-template, create-smtp-profile, and create-sso-configuration."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Phished?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Phished in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does Phished MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Phished requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Phished?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Phished is developed by Phished BV. It is listed as partner on the Claude connector directory."
      }
    }
  ],
