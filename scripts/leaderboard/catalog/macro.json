  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Macro to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Macro to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp-server.macro.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Macro MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Macro lists 46 MCP tools, including BashCodeExecution, BulkSetEntityPropertyOptions, ContentSearch, CreateDocument, CreateImportEntity, CreateProject, CreateTag, DeleteImportEntity, DeleteTag, EditDocument, EditTag, and GetCompany."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Macro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Macro in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Macro MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Macro requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Macro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Macro is developed by Macro. It is listed as community on the Claude connector directory."
      }
    }
