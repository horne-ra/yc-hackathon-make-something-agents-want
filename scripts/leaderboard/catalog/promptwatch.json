  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Promptwatch to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Promptwatch to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://server.promptwatch.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Promptwatch MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Promptwatch lists 67 MCP tools, including list_projects, create_project, list_models, list_monitors, get_monitor, create_monitor, update_monitor, delete_monitor, list_prompts, get_prompt, create_prompt, and create_prompts_bulk."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Promptwatch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Promptwatch in data-analytics on the Manufact MCP catalog include Epicure, Newsflash, Point Topic, Pricing Optimizer AI, and StatCite."
      }
    },
    {
      "@type": "Question",
      "name": "Does Promptwatch MCP require authentication?",
