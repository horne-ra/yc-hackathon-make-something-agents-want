  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Publive to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Publive to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.thepublive.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Publive MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Publive lists 61 MCP tools, including add_liveblog_update, create_category, create_component_schema, create_content_type_schema, create_post, create_tag, delete_category, delete_component_schema, delete_content_type_schema, delete_liveblog_update, delete_media_asset, and delete_post."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Publive?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Publive in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
