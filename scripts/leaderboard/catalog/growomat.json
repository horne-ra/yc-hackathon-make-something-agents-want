  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Growomat to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Growomat to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.growomat.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Growomat MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Growomat lists 65 MCP tools, including account_summary, attach_asset_to_ad, attach_asset_to_campaign, cancel_sync, create_ad, create_ad_group, create_asset, create_business, create_campaign, create_conversion_source, create_keyword, and delete_ad."
      }
    },
