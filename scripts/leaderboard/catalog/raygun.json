  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Raygun to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Raygun to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.raygun.com/v3/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Raygun MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Raygun lists 34 MCP tools, including apm_hotspots_search, apm_issue_investigate, apm_issues_search, apm_trace_investigate, apm_traces_search, application_get_details, application_regenerate_api_key, applications_list, applications_search, customer_investigate, customers_search, and deployment_create."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Raygun?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Raygun in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does Raygun MCP require authentication?",
      "acceptedAnswer": {
