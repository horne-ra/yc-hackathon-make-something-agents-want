  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Slice to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Slice to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.app.sliceglobal.com/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Slice MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Slice lists 33 MCP tools, including cap_table_get_summary, cap_table_search_entries, companies_get_summary, compliance_get_object_tickets, compliance_get_tickets_breakdown, equity_pools_get_summaries, grants_get_pizza_tracker, grants_get_types_breakdown, grants_get_vesting_bullet_chart, ownership_get_company_breakdown, ownership_get_stakeholder_breakdown, and payments_get_pending_list."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Slice?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Slice in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does Slice MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Slice requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Slice?",
