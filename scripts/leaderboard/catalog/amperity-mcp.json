  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Amperity MCP to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Amperity MCP to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.amperity.com/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Amperity MCP MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Amperity MCP lists 266 MCP tools, including ael_evaluate, ai_system_prompt_get, alert_get_subscription, alert_list_subscriptions, alert_subscribe, alert_unsubscribe, bridge_connect, bridge_create, bridge_create_share, bridge_delete, bridge_delete_share, and bridge_disconnect."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Amperity MCP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Amperity MCP in data-analytics on the Manufact MCP catalog include Epicure, Newsflash, Point Topic, Pricing Optimizer AI, and StatCite."
      }
    },
    {
      "@type": "Question",
      "name": "Does Amperity MCP MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Amperity MCP requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Amperity MCP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Amperity MCP is developed by Amperity. It is listed as community on the Claude connector directory."
      }
    }
