  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Ticket Tailor to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Ticket Tailor to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.tickettailor.ai/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Ticket Tailor MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ticket Tailor lists 65 MCP tools, including bundle_create, bundle_delete, bundle_update, check_in_create, check_ins_get, checkout_form_element_by_id_get, checkout_form_element_update, checkout_form_elements_get, checkout_forms_get, discount_by_id_get, discount_create, and discount_delete."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Ticket Tailor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Ticket Tailor in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does Ticket Tailor MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ticket Tailor requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
