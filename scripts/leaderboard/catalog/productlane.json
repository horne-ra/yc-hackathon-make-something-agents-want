  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Productlane to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Productlane to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://productlane.com/api/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Productlane MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Productlane lists 96 MCP tools, including changelogs_broadcast, changelogs_create, changelogs_create_tag, changelogs_delete, changelogs_delete_tag, changelogs_get, changelogs_list, changelogs_list_tags, changelogs_update, changelogs_update_tag, companies_create, and companies_delete."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Productlane?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Productlane in customer-support on the Manufact MCP catalog include Assembled, Brainfish, ClearFeed, Conduit, and DevRev."
      }
    },
    {
      "@type": "Question",
      "name": "Does Productlane MCP require authentication?",
      "acceptedAnswer": {
