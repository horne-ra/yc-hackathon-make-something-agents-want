  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Hostinger Connector to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Hostinger Connector to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.hostinger.com/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Hostinger Connector MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hostinger Connector lists 363 MCP tools, including DNS_deleteDNSRecordsV1, DNS_getDNSRecordsV1, DNS_getDNSSnapshotListV1, DNS_getDNSSnapshotV1, DNS_resetDNSRecordsV1, DNS_restoreDNSSnapshotV1, DNS_updateDNSRecordsV1, DNS_validateDNSRecordsV1, VPS_activateFirewallV1, VPS_attachPublicKeyV1, VPS_createFirewallRuleV1, and VPS_createNewFirewallV1."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Hostinger Connector?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Hostinger Connector in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does Hostinger Connector MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hostinger Connector requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Hostinger Connector?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hostinger Connector is developed by Hostinger. It is listed as community on the Claude connector directory."
      }
    }
  ],
