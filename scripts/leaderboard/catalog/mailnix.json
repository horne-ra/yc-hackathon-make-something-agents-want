  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add mailnix to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add mailnix to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.mailnix.ch/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the mailnix MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "mailnix lists 78 MCP tools, including account_claim, account_status, destination_promote_to_live, destination_set_mode, email_destination_set_shadow, email_destinations_list, email_domain_verify_records, email_domain_verify_status, email_failover_policy_set, email_html_snippet_generate, email_inbound_messages_list, and email_inbound_route_create."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to mailnix?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to mailnix in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
