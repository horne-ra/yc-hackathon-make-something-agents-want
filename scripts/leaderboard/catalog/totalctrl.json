  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add TotalCtrl to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add TotalCtrl to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.totalctrl.app/api/mcp/v1. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the TotalCtrl MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TotalCtrl lists 111 MCP tools, including contacts_create, contacts_delete, contacts_get, contacts_list, contacts_list_custom_fields, contacts_update, crm_create_company, crm_create_contact, crm_create_deal, crm_create_template, crm_get_company, and crm_get_contact."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to TotalCtrl?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to TotalCtrl in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does TotalCtrl MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TotalCtrl requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops TotalCtrl?",
      "acceptedAnswer": {
        "@type": "Answer",
