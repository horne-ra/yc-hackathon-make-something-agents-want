  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Kpler to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Kpler to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://claude.mcp.kpler.com/v1/mcp/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Kpler MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Kpler lists 55 MCP tools, including kpler_get_ais_historical, kpler_get_ais_latest, kpler_get_arbitrage_benchmarks, kpler_get_arbitrage_combinations, kpler_get_arbitrage_products, kpler_get_arbitrage_regions, kpler_get_arbitrage_timeseries, kpler_get_arbitrage_timeseries_rolling, kpler_get_cargo_fleet_metrics, kpler_get_fleet_metrics_vessels, kpler_get_flows, and kpler_get_lng_diversions."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Kpler?",
