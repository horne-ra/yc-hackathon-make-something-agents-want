  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add CloudBees Unify MCP Server to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add CloudBees Unify MCP Server to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.cloudbees.io/v1/mcp?toolset=all. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the CloudBees Unify MCP Server MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CloudBees Unify MCP Server lists 110 MCP tools, including actions_list, automation_approve_manual_gate, automation_jobs_list, automation_pending_tasks_list, automation_reject_manual_gate, automation_rerun, automation_stop, automation_trigger_by_branch, branches_list, controllers_data_get, controllers_list, and endpoint_add."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to CloudBees Unify MCP Server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to CloudBees Unify MCP Server in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
