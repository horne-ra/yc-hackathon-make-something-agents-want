  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Hitsteps Web Analytics to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Hitsteps Web Analytics to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://www.hitsteps.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Hitsteps Web Analytics MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hitsteps Web Analytics lists 87 MCP tools, including clear_alerts, compare_traffic_periods, create_campaign, create_chat_ticket, create_goal, create_label, create_recovery_action, create_uptime_contact, create_uptime_monitor, create_uptime_schedule, create_website, and delete_campaign."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Hitsteps Web Analytics?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Hitsteps Web Analytics in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Hitsteps Web Analytics MCP require authentication?",
