  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Filevine to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Filevine to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.filevineapp.com/mcp/api-v2. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Filevine MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Filevine lists 112 MCP tools, including delete_Collections_TaskflowButtons, delete_Projects_Forms_TaskflowButtons, delete_fv_app_tasks, get_Projects_Collections_TaskflowButtons, get_Projects_Forms_TaskflowButtons, get_deadlines_timely_calculations, get_fv_app_Appointments, get_fv_app_Contacts, get_fv_app_Contacts_2, get_fv_app_Contacts_Countries, get_fv_app_Contacts_PrimaryLanguages, and get_fv_app_Contacts_addresses."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Filevine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Filevine in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Filevine MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Filevine requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Filevine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Filevine is developed by Filevine. It is listed as partner on the Claude connector directory."
      }
    }
  ],
