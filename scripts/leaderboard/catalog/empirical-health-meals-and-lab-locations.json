                "type": "integer",
                "default": 5,
                "maximum": 20,
                "minimum": 1
              },
              "location": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "zipCode"
                    ],
                    "properties": {
                      "zipCode": {
                        "type": "string",
                        "pattern": "^\\d{5}(?:-\\d{4})?$",
                        "description": "US ZIP code, optionally ZIP+4."
                      }
                    },
