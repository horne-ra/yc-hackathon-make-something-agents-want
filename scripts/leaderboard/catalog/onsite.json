  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Onsite to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Onsite to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.onsite.fm/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Onsite MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Onsite lists 47 MCP tools, including create_comment, create_maintenance_item, get_asset, get_broadcast, get_case, get_document, get_help_article, get_site, list_access_control_devices, list_accounts, list_activity, and list_amenities."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Onsite?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Onsite in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Onsite MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Onsite requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Onsite?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Onsite is developed by Onsite FM Pty Ltd. It is listed as community on the Claude connector directory."
      }
    }
  ],
