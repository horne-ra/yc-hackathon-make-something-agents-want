  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add SiteGuru to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add SiteGuru to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.siteguru.co/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the SiteGuru MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SiteGuru lists 26 MCP tools, including find_pages, get_backlink_opportunities, get_collection_issues, get_competitor_analysis, get_declining_content, get_focus_keywords, get_growing_content, get_keyword_cannibalization, get_lost_keywords, get_low_hanging_fruit, get_new_keywords, and get_page_content_trend."
      }
    },
    {
