  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Servebolt to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Servebolt to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.servebolt.com/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Servebolt MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Servebolt lists 83 MCP tools, including activate-plugin-tool, activate-theme-tool, add-option-tool, add-user-role-tool, check-core-update-tool, check-db-tool, check-domain-dns-tool, check-http-response-tool, clear-opcache-tool, clone-site-tool, connect-domain-tool, and create-bolt-tool."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Servebolt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Servebolt in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does Servebolt MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Servebolt requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Servebolt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Servebolt is developed by Servebolt. It is listed as community on the Claude connector directory."
      }
    }
