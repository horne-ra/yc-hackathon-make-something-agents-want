  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Wiv to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Wiv to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.wiv.ai/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Wiv MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wiv lists 64 MCP tools, including wiv_add_customer_users, wiv_archive_space, wiv_cases_query, wiv_create_customer_integration, wiv_create_dashboard, wiv_create_datastore, wiv_create_datastore_records, wiv_create_integration, wiv_create_msp_customer, wiv_create_space, wiv_create_workflow, and wiv_delete_dashboard."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Wiv?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Wiv in data-analytics on the Manufact MCP catalog include Epicure, Newsflash, Point Topic, Pricing Optimizer AI, and StatCite."
      }
    },
    {
      "@type": "Question",
      "name": "Does Wiv MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wiv requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
