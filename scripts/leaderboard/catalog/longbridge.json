  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Longbridge to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Longbridge to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.longbridge.com/v2. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Longbridge MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Longbridge lists 126 MCP tools, including account_balance, ah_premium, ah_premium_intraday, alert_add, alert_delete, alert_disable, alert_enable, alert_list, anomaly, broker_holding, broker_holding_daily, and broker_holding_detail."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Longbridge?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Longbridge in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does Longbridge MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Longbridge requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
