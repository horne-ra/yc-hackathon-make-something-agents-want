  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add PagerDuty to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add PagerDuty to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.pagerduty.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the PagerDuty MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PagerDuty lists 64 MCP tools, including add_note_to_incident, add_responders, add_team_member, append_event_orchestration_router_rule, create_alert_grouping_setting, create_incident, create_schedule, create_schedule_override, create_service, create_status_page_post, create_status_page_post_update, and create_team."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to PagerDuty?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to PagerDuty in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does PagerDuty MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PagerDuty requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
