  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add BasicOps to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add BasicOps to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://app.basicops.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the BasicOps MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BasicOps lists 97 MCP tools, including add_file_to_task, bulk_create_or_update_note, bulk_create_or_update_project, bulk_create_or_update_section, bulk_create_or_update_task, bulk_create_or_update_template, connect_agent, create_channel, create_chat, create_groupchat, create_message_in_channel, and create_message_in_chat."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to BasicOps?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to BasicOps in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does BasicOps MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BasicOps requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops BasicOps?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BasicOps is developed by BasicOps. It is listed as community on the Claude connector directory."
      }
    }
