  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add PlantPredict to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add PlantPredict to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.plantpredict.terabase.energy/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the PlantPredict MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PlantPredict lists 171 MCP tools, including Add_Time_Series_CSV_data, Add_Time_Series_data_via_JSON, Cancel_a_Prediction_for_a_Project_Id_and_Prediction_Id, Clone_Prediction_Time_Series, Clone_a_Prediction, Convert_a_PVC_to_PVJ_using_the_HTTP_requests_query_strin, Create_a_new_Weather_file, Delete_Time_Series_data, Delete_a_Module_by_Id, Delete_a_Note_for_a_Module_by_Note_Id_and_Module_Id, Delete_a_Note_for_a_Project_by_Project_Id_and_Note_Id, and Delete_a_Note_for_an_Inverter_by_Note_Id_and_Inverter_Id."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to PlantPredict?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to PlantPredict in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does PlantPredict MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PlantPredict requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops PlantPredict?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PlantPredict is developed by Terabase Energy, Inc. It is listed as community on the Claude connector directory."
      }
    }
