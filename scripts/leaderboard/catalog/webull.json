  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Webull to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Webull to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.webull.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Webull MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Webull lists 71 MCP tools, including add_watchlist_instruments, create_watchlist, delete_watchlist, get_account_balance, get_account_list, get_account_positions, get_analyst_rating, get_analyst_target_price, get_company_profile, get_crypto_bars, get_crypto_instruments, and get_crypto_snapshot."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Webull?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Webull in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does Webull MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Webull requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
