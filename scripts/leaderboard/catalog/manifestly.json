  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Manifestly to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Manifestly to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.manifest.ly/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Manifestly MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Manifestly lists 66 MCP tools, including about, add_business_calendar_holiday, add_comment, approve_run_step, assign_run_step, assign_run_step_by_email, assign_run_step_by_name, close_run, complete_run_step, complete_subtask, create_business_calendar, and create_run."
      }
    },
