  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Ahrefs to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Ahrefs to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.ahrefs.com/mcp/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Ahrefs MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ahrefs lists 61 MCP tools, including batch-analysis, brand-radar-ai-responses, brand-radar-cited-domains, brand-radar-cited-pages, brand-radar-impressions-history, brand-radar-impressions-overview, brand-radar-mentions-history, brand-radar-mentions-overview, brand-radar-sov-history, brand-radar-sov-overview, doc, and keywords-explorer-matching-terms."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Ahrefs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Ahrefs in marketing-seo on the Manufact MCP catalog include Buzzfy, Airefs AI Visibility, TalkGenAI, RankControl, and attentive-mcp-server."
      }
    },
    {
      "@type": "Question",
      "name": "Does Ahrefs MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ahrefs requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Ahrefs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ahrefs is developed by Ahrefs Pte. Ltd.. It is listed as partner on the Claude connector directory."
      }
