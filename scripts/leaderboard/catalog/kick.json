  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Kick to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Kick to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://use.kick.co/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Kick MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Kick lists 39 MCP tools, including financial_accounts_query, transactions_query, categories_query, classes_query, counterparties_query, rules_query, accounting_query, opening_balances_query, journals_query, documents_query, documents_download, and entities_query."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Kick?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Kick in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does Kick MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Kick requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
