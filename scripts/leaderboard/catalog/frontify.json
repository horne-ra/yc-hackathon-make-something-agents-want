  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Frontify to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Frontify to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.frontify-integrations.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Frontify MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Frontify lists 53 MCP tools, including frontify_add_asset_revision, frontify_add_asset_revision_from_url, frontify_add_asset_tags, frontify_add_asset_targets, frontify_add_collection_assets, frontify_add_custom_metadata, frontify_add_workflow_checklist_item, frontify_cancel_creative_exports, frontify_create_asset, frontify_create_asset_comment, frontify_create_asset_from_url, and frontify_create_collection."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Frontify?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Frontify in marketing-seo on the Manufact MCP catalog include Buzzfy, Airefs AI Visibility, TalkGenAI, RankControl, and attentive-mcp-server."
      }
    },
    {
      "@type": "Question",
      "name": "Does Frontify MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Frontify requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
