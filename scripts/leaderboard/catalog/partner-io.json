  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Partner.io to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Partner.io to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.partner.io/mcp/company. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Partner.io MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Partner.io lists 40 MCP tools, including create-lead, create-lead-payment, create-partner, create-partner-rep, create-partner-reward, create-partner-type, create-program-tier, create-webhook-subscription, delete-lead, delete-partner, delete-partner-rep, and delete-partner-type."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Partner.io?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Partner.io in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Partner.io MCP require authentication?",
