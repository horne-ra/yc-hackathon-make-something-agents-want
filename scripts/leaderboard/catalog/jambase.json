  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add JamBase to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add JamBase to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.jambase.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the JamBase MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "JamBase lists 25 MCP tools, including findArtistAndFetchEvents, findVenueAndFetchEvents, getArticlesForArtist, getArticlesForEvent, getArtist, getCity, getEvent, getGenres, getMetro, getMetros, getMyArticleFeed, and getMyFollowedArtistsUpcomingShows."
      }
    },
    {
