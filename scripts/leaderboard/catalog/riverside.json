  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Riverside to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Riverside to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.riverside.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Riverside MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Riverside lists 59 MCP tools, including editing_add_lower_third, editing_add_text_overlay, editing_apply_brand, editing_apply_smart_layout, editing_apply_smart_mutes, editing_apply_verified_edit_plan, editing_batch, editing_clone_edit, editing_compare_revisions, editing_create_edit_from_recording, editing_cut_time_ranges, and editing_get_asset_metadata."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Riverside?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Riverside in design-creative on the Manufact MCP catalog include Motion, MotionVid, Sleek, Streamloop MCP, and Image Generation."
      }
    },
    {
      "@type": "Question",
      "name": "Does Riverside MCP require authentication?",
