  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add NAVI Protocol to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add NAVI Protocol to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://open-api.naviprotocol.io/api/mcp."
      }
    },
    {
      "@type": "Question",
      "name": "Is NAVI Protocol MCP ready for ChatGPT and Claude?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of September 15, 2026, NAVI Protocol scores 82/100 on Manufact's MCP publishing checklist. The scan does not yet meet ChatGPT publishing checks and does not yet meet Claude publishing checks. Passing these checks does not guarantee marketplace approval."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the NAVI Protocol MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NAVI Protocol provides these MCP tools: navi_get_pools, navi_get_health_factor, navi_get_reserves_config, navi_get_incentive_apy, navi_prepare_supply, navi_prepare_withdraw, navi_prepare_borrow, and navi_prepare_repay."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to NAVI Protocol?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to NAVI Protocol in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does NAVI Protocol MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NAVI Protocol does not require authentication. It is a public MCP endpoint you can connect without logging in."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops NAVI Protocol?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NAVI Protocol is developed by NAVI Protocol. It is listed as community on the Claude connector directory."
      }
    }
  ],
