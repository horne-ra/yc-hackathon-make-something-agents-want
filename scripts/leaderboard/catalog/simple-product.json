  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Simple Product to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Simple Product to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://simpleproduct.dev/api/mcp/v1. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Simple Product MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Simple Product lists 61 MCP tools, including create_board, create_card, create_comment, create_doc, create_feedback, create_org, create_person, create_release, draft_email, get_board, get_card, and get_cards_for_doc."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Simple Product?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Simple Product in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Simple Product MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Simple Product requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Simple Product?",
      "acceptedAnswer": {
