  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Roboflow to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Roboflow to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.roboflow.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Roboflow MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Roboflow lists 67 MCP tools, including agent_chat, agent_conversation_get, agent_conversations_list, agent_workflow_publish, annotation_batches_get, annotation_batches_list, annotation_jobs_create, annotations_save, async_tasks_get, autolabel_job_get, autolabel_start, and devices_create."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Roboflow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Roboflow in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does Roboflow MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Roboflow requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Roboflow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Roboflow is developed by Roboflow. It is listed as partner on the Claude connector directory."
      }
    }
  ],
