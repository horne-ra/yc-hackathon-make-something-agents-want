  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Atlas to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Atlas to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.atlas.kitchen/."
      }
    },
    {
      "@type": "Question",
      "name": "Is Atlas MCP ready for ChatGPT and Claude?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 6, 2026, Atlas scores 0/100 on Manufact's MCP publishing checklist. The scan does not yet meet ChatGPT publishing checks and does not yet meet Claude publishing checks. Passing these checks does not guarantee marketplace approval."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Atlas MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Atlas lists 77 MCP tools, including add_product_to_pos_layout, add_tile_to_pos_layout, archive_outlet, book_delivery, cancel_delivery, cancel_order, create_announcement, create_cash_voucher, create_cross_sell_group, create_discount, create_landing_page_banner, and create_menu_section."
      }
    },
