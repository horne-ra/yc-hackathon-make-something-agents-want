  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add MobiCRM to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add MobiCRM to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.mobicrm.app/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the MobiCRM MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MobiCRM lists 42 MCP tools, including create_account, create_account_discussion_topic, create_appointment, create_contact, create_minutes, create_todo, delete_account_discussion_topic, get_account, get_account_addresses, get_account_badges, get_account_by_external_id, and get_account_contacts."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to MobiCRM?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to MobiCRM in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does MobiCRM MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MobiCRM requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops MobiCRM?",
      "acceptedAnswer": {
