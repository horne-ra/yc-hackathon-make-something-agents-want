  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Great Arrow Digital to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Great Arrow Digital to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://www.greatarrow.ai/api/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Great Arrow Digital MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Great Arrow Digital lists 249 MCP tools, including accomplishment_create, accomplishment_list, accomplishment_review, account_budget_update, account_cost_intelligence, account_export, account_token_pause, account_token_revoke, account_tokens_create, account_tokens_list, agent_handoff_checkpoint, and agent_invoke."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Great Arrow Digital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Great Arrow Digital in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Great Arrow Digital MCP require authentication?",
