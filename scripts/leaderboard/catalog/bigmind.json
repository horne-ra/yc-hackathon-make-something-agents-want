  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Bigmind to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Bigmind to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.bigmind.ai/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Bigmind MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bigmind lists 136 MCP tools, including addListColumns, addListRows, addListTargetablePeople, adminCreateDemoMeetingSession, countListRowsByColumnValue, createBattlecard, createCaseStudy, createCategory, createCoachingSimulation, createCompetitor, createCustomVocabulary, and createDocumentTemplate."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Bigmind?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Bigmind in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bigmind MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bigmind requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Bigmind?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bigmind is developed by Bigmind. It is listed as community on the Claude connector directory."
      }
    }
