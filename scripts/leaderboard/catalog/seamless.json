    {
      "@type": "Question",
      "name": "How do I add Seamless to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Seamless to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.seamless.ai/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
