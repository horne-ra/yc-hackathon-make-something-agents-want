  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Metal to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Metal to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.metal.ai/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Metal MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Metal lists 24 MCP tools, including list_companies, search_companies, list_company_tags, get_company, get_document, search_documents, search_people, search_users, get_user, list_teams, get_team, and list_workflows."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Metal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Metal in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does Metal MCP require authentication?",
