  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Statista to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Statista to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.statista.ai/v1/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Statista MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Statista provides these MCP tools: search-statistics, get-chart-data-by-id, search-consumer-insights, fetch-consumer-insights, search-market-insights, and fetch-market-insights."
      }
    },
    {
      "@type": "Question",
      "name": "Does Statista MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Statista requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Statista?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Statista is developed by Statista Gmbh. It is listed as community on the Claude connector directory."
      }
    }
