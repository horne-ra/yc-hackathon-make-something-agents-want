  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Civic Marketplace to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Civic Marketplace to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.civicmarketplace.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Civic Marketplace MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Civic Marketplace lists 89 MCP tools, including add_supplier_address, add_supplier_capacity_nigp_codes, add_supplier_catalog, add_supplier_certifications, add_supplier_keywords, add_supplier_video, archive_coop_quote_requests, archive_quick_quote_requests, ask_supplier_solicitation_question, bulk_create_coop_requests, bulk_create_quick_quote_requests, and cancel_coop_quote_request."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Civic Marketplace?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Civic Marketplace in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Civic Marketplace MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Civic Marketplace requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
