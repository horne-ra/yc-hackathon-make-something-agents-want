  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Oviond to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Oviond to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.oviond.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Oviond MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oviond lists 180 MCP tools, including add_asset_to_page, add_button_widget, add_data_widget, add_domain, add_email_domain, add_embed_widget, add_image_widget, add_project_section, add_text_widget, add_title_widget, archive_asset, and archive_automation."
      }
    },
    {
