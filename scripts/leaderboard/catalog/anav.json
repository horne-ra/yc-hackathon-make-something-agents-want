  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add ANAV to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add ANAV to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://anav.app/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the ANAV MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ANAV lists 90 MCP tools, including absence_delete, absence_list, absence_reason_list, absence_update, actual_expense_create, actual_expense_delete, actual_expense_list, actual_expense_update, actual_expenses_bulk_create, affectation_create, affectation_delete, and affectation_generate_time_logs."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to ANAV?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to ANAV in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does ANAV MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ANAV requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops ANAV?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ANAV is developed by ANAV. It is listed as community on the Claude connector directory."
      }
