  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Onepage to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Onepage to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.onepage.io/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Onepage MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Onepage lists 52 MCP tools, including archive_page, build_react_app, build_siteui_package, confirm_media_upload, create_color_schema, create_crm_form, create_folder, create_font_kit, create_page, create_section, create_site, and create_siteui_package."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Onepage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Onepage in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Onepage MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Onepage requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Onepage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Onepage is developed by Onepage GmbH. It is listed as community on the Claude connector directory."
      }
    }
  ],
