  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Mekago to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Mekago to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://www.mekago.fr/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Mekago MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mekago lists 116 MCP tools, including api-key-create, api-key-list, api-key-revoke, customer-notification-preferences-get, customer-notification-preferences-update, customer-profile-get, customer-profile-update, customer-reservation-cancel, customer-reservation-create, customer-reservation-get, customer-reservation-reschedule, and customer-reservations-list."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Mekago?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Mekago in commerce-shopping on the Manufact MCP catalog include EbooksDepository, ecoExperten Energieausweis, PHS Pallets, Promotion Pros Catalog, and RCO-A2A."
      }
    },
    {
      "@type": "Question",
      "name": "Does Mekago MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mekago requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Mekago?",
      "acceptedAnswer": {
