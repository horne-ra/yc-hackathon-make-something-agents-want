  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add VideoDB to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add VideoDB to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.videodb.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the VideoDB MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VideoDB lists 88 MCP tools, including add_subtitles, aggregate_index, ask_collection, ask_video, compile_clips, connect_rtstream, create_collection, create_event, create_highlight_clip, create_index, create_rtstream_alert, and create_rtstream_index."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to VideoDB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to VideoDB in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does VideoDB MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VideoDB requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops VideoDB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VideoDB is developed by VideoDB. It is listed as community on the Claude connector directory."
      }
    }
