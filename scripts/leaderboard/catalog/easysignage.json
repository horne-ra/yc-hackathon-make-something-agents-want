  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add EasySignage to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add EasySignage to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.easysignage.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the EasySignage MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "EasySignage lists 86 MCP tools, including clone_playlist, create_channel, create_display_group, create_folder, create_media, create_media_from_url, create_playlist, create_schedule, create_schedule_event, create_sync_group, create_video_wall, and create_video_wall_design."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to EasySignage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to EasySignage in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does EasySignage MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "EasySignage requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops EasySignage?",
