  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add kernelCAD to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add kernelCAD to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.kernelcad.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the kernelCAD MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "kernelCAD lists 66 MCP tools, including generate_kcad_from_prompt, lookup_authoring_skill, evaluate_script, lookup_cookbook, list_features, add_feature, remove_feature, add_pattern_feature, set_param_value, params_list, params_update, and list_assemblies."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to kernelCAD?",
      "acceptedAnswer": {
