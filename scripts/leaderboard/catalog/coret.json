  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Coret to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Coret to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.coret.id/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Coret MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coret lists 57 MCP tools, including add_comment, add_node, batch_nodes, book_add_page, book_by_node, book_create, book_get, book_list, book_search, book_update_page, create_arrow, and create_folder."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Coret?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Coret in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Coret MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coret requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
