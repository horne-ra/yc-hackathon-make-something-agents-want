  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Files.com to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Files.com to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://app.files.com/api/ai/mcp/v1. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Files.com MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Files.com lists 61 MCP tools, including Copy_File, Create_Bundle, Create_Bundle_Notification, Create_Bundle_Recipient, Create_Folder, Create_Group, Create_Permission, Create_User, Delete_Bundle, Delete_Bundle_Notification, Delete_File, and Delete_Group."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Files.com?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Files.com in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Files.com MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Files.com requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Files.com?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Files.com is developed by Files.com. It is listed as partner on the Claude connector directory."
      }
    }
