  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Contour to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Contour to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.contour-prod-api.prod.i.usecontour.ai/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Contour MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Contour lists 80 MCP tools, including create_entity, create_living_document, create_milestone, create_project, create_requirement, create_role, create_stakeholder, create_success_criterion, create_tag, create_task, create_task_dependency, and create_work_phase."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Contour?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Contour in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Contour MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Contour requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Contour?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Contour is developed by Contour AI. It is listed as community on the Claude connector directory."
      }
    }
  ],
