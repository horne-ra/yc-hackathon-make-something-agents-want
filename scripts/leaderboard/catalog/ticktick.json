  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add TickTick to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add TickTick to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.ticktick.com/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the TickTick MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TickTick lists 92 MCP tools, including get_user_preference, get-user-preference, search_task, search-task, get_task_by_id, get-task-by-id, list_undone_tasks_by_time_query, list-undone-tasks-by-time-query, list_undone_tasks_by_date, list-undone-tasks-by-date, list_completed_tasks_by_date, and list-completed-tasks-by-date."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to TickTick?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to TickTick in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does TickTick MCP require authentication?",
      "acceptedAnswer": {
