  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Mailrith to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Mailrith to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.mailrith.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Mailrith MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mailrith lists 52 MCP tools, including analytics_create_report, analytics_get_report, automations_create, automations_get, automations_list, automations_preflight, automations_preview_journey, automations_send_test, automations_update, automations_update_status, broadcasts_cancel, and broadcasts_create."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Mailrith?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Mailrith in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Mailrith MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mailrith requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Mailrith?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mailrith is developed by Mailrith. It is listed as community on the Claude connector directory."
      }
    }
