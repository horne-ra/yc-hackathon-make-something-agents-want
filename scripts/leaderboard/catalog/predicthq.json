  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add PredictHQ to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add PredictHQ to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.predicthq.com/v1/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the PredictHQ MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PredictHQ lists 58 MCP tools, including auth_get_subscription, beam_api_create_analysis, beam_api_create_analysis_group, beam_api_delete_analysis, beam_api_delete_analysis_group, beam_api_get_analysis, beam_api_get_analysis_correlation, beam_api_get_analysis_feature_importance, beam_api_get_analysis_group, beam_api_get_analysis_group_feature_importance, beam_api_list_analyses, and beam_api_list_analysis_groups."
      }
    },
