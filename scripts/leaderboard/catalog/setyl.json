  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Setyl to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Setyl to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://app.setyl.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Setyl MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Setyl lists 93 MCP tools, including archive_asset, archive_department, archive_group, archive_legal_entity, archive_license, archive_location, archive_person, archive_service_account, archive_sublocation, archive_team, assign_app_to_group, and assign_app_to_team."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Setyl?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Setyl in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Setyl MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Setyl requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Setyl?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Setyl is developed by Setyl Ltd. It is listed as community on the Claude connector directory."
      }
    }
  ],
