  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Lovable to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Lovable to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.lovable.dev/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Lovable MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lovable lists 35 MCP tools, including get_me, list_workspaces, get_workspace, list_projects, get_project, create_project, deploy_project, remix_project, set_project_visibility, set_folder_visibility, list_template_projects, and list_library_projects."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Lovable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Lovable in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does Lovable MCP require authentication?",
