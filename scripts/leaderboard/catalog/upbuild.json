  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Upbuild to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Upbuild to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://connector.upbuild.app/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Upbuild MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Upbuild lists 55 MCP tools, including adobe_list_companies, adobe_list_dimensions, adobe_list_metrics, adobe_list_report_suites, adobe_run_report, cm360_get_floodlight_activity, cm360_get_floodlight_config, cm360_get_floodlight_tag, cm360_get_report_file, cm360_list_advertisers, cm360_list_campaigns, and cm360_list_floodlight_activities."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Upbuild?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Upbuild in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Upbuild MCP require authentication?",
