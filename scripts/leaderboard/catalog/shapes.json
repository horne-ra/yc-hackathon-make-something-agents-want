  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Shapes to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Shapes to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.shapes.co/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Shapes MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Shapes lists 34 MCP tools, including get_employees, get_employee, get_current_user, get_employee_field_types, get_employee_field_values, get_entities, get_profile_picture, employee_insights, get_reporting_chain, search_in_hierarchy, get_performance_review_cycles, and get_performance_review_participants."
      }
    },
    {
