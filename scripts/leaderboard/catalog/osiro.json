  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Osiro to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Osiro to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.osiro.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Osiro MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Osiro lists 52 MCP tools, including activate_sequence, add_funnel_block, add_funnel_composition, add_funnel_step, add_landing_page_block, create_email_sequence, create_funnel, create_landing_page, create_message, create_sequence, edit_funnel_block, and edit_landing_page_block."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Osiro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Osiro in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Osiro MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Osiro requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Osiro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Osiro is developed by Customic GmbH. It is listed as community on the Claude connector directory."
      }
    }
  ],
