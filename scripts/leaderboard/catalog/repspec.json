  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add RepSpec to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add RepSpec to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://app.repspec.ai/api/mcp-connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the RepSpec MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "RepSpec provides these MCP tools: search_products, get_product_details, and list_manufacturers."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to RepSpec?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to RepSpec in business-productivity on the Manufact MCP catalog include Pyth, Domhaul, Idiolect AI, aster-share, and aquent-jobs."
      }
    },
    {
      "@type": "Question",
      "name": "Does RepSpec MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "RepSpec does not require authentication. It is a public MCP endpoint you can connect without logging in."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops RepSpec?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "RepSpec is developed by MC Connected. It is listed as community on the Claude connector directory."
      }
    }
