  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add ChartMogul to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add ChartMogul to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.chartmogul.com/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the ChartMogul MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ChartMogul lists 76 MCP tools, including ARPA, ASP, CMRR, CMRR_movements, LTV, MRR_and_ARR, MRR_movements, account_retention_for_benchmarks, benchmarks, benchmarks_metadata, benchmarks_segmented, and cash_flow."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to ChartMogul?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to ChartMogul in data-analytics on the Manufact MCP catalog include Epicure, Newsflash, Point Topic, Pricing Optimizer AI, and StatCite."
      }
    },
    {
      "@type": "Question",
      "name": "Does ChartMogul MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
