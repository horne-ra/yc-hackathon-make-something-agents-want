  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add BEEM to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add BEEM to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.beemdata.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the BEEM MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BEEM lists 69 MCP tools, including beem_await_operation, beem_build_dashboard, beem_create_and_deploy_dataset, beem_create_and_deploy_dataset_test, beem_create_dashboard, beem_create_dashboard_widget, beem_create_data_object, beem_create_dataset, beem_create_dataset_test, beem_create_folder, beem_create_visualization, and beem_delete_dashboard_widget."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to BEEM?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to BEEM in data-analytics on the Manufact MCP catalog include Epicure, Newsflash, Point Topic, Pricing Optimizer AI, and StatCite."
      }
    },
    {
      "@type": "Question",
      "name": "Does BEEM MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BEEM requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops BEEM?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BEEM is developed by BEEM. It is listed as community on the Claude connector directory."
      }
    }
