  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add TrueProfit to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add TrueProfit to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.trueprofit.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the TrueProfit MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TrueProfit lists 30 MCP tools, including get_ad_costs, get_all_shop_insights, get_blog_post, get_cac_metrics, get_cogs_return, get_connected_platforms, get_current_user, get_custom_costs, get_customer_overview, get_marketing_attribution, get_order_insights, and get_orders_summary."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to TrueProfit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to TrueProfit in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does TrueProfit MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TrueProfit requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops TrueProfit?",
