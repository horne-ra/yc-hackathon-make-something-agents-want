  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Recruit CRM to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Recruit CRM to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://agent.recruitcrm.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Recruit CRM MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Recruit CRM lists 112 MCP tools, including add_records_to_hotlist, analyze_job_pipeline, assign_candidate_to_job, count_candidates, count_companies, count_contacts, count_jobs, create_call_log, create_candidate, create_company, create_contact, and create_hotlist."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Recruit CRM?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Recruit CRM in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Recruit CRM MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Recruit CRM requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Recruit CRM?",
      "acceptedAnswer": {
