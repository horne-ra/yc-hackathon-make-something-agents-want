  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Acoustic to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Acoustic to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.goacoustic.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Acoustic MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Acoustic lists 85 MCP tools, including add_email_sections, api_limits, campaign, campaign_executions, campaign_instances, campaign_schedule_preview, campaigns, campaigns_dimension, completed_sessions, consent_groups_dimension, consent_strategies, and consent_strategies_dimension."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Acoustic?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Acoustic in marketing-seo on the Manufact MCP catalog include Buzzfy, Airefs AI Visibility, TalkGenAI, RankControl, and attentive-mcp-server."
      }
    },
    {
      "@type": "Question",
      "name": "Does Acoustic MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Acoustic requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Acoustic?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Acoustic is developed by Acoustic. It is listed as community on the Claude connector directory."
      }
    }
