  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add LimaCharlie to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add LimaCharlie to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.limacharlie.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the LimaCharlie MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LimaCharlie lists 175 MCP tools, including add_group_member, add_group_owner, add_org_to_group, add_org_user, add_output, add_tag, add_user_permission, analyze_lcql_query, batch_search_iocs, collect_velociraptor_artifact, create_api_key, and create_group."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to LimaCharlie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to LimaCharlie in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does LimaCharlie MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LimaCharlie requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops LimaCharlie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LimaCharlie is developed by LimaCharlie. It is listed as community on the Claude connector directory."
      }
    }
