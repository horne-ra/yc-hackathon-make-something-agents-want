  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add ShipBob to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add ShipBob to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.shipbob.com/developer-api/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the ShipBob MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ShipBob lists 72 MCP tools, including channels-get-channel, inventory-get-inventory, inventory-get-inventory-by-inventoryid, inventory-get-inventory-level, inventory-get-inventory-level-by-inventoryid, inventory-get-locations, inventory-get-locations-by-inventoryid, inventory-get-lots, inventory-get-lots-by-inventoryid, orders-get-shipping-method, orders-get-store-order-json-by-orderid, and orders-get-logs-by-orderid-shipmentid."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to ShipBob?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to ShipBob in commerce-shopping on the Manufact MCP catalog include EbooksDepository, ecoExperten Energieausweis, PHS Pallets, Promotion Pros Catalog, and RCO-A2A."
      }
    },
    {
      "@type": "Question",
      "name": "Does ShipBob MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ShipBob requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops ShipBob?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ShipBob is developed by ShipBob. It is listed as partner on the Claude connector directory."
      }
    }
