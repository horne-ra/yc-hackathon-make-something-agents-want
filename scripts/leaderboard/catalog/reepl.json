  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Reepl to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Reepl to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://connect.reepl.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Reepl MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Reepl lists 57 MCP tools, including add_comment_to_post, add_contact_to_list, create_carousel_draft, create_draft, delete_carousel_draft, delete_draft, delete_scheduled_post, generate_carousel_content, generate_ideas, get_audience_profiles, get_carousel_draft, and get_collections."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Reepl?",
      "acceptedAnswer": {
        "@type": "Answer",
