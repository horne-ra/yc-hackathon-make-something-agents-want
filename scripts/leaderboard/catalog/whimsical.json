  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Whimsical to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Whimsical to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.whimsical.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Whimsical MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Whimsical provides these MCP tools: create, edit, search, fetch, file_tree, list_workspaces, how_to, generate_diagram, generate_mind_map, generate_wireframe, and doc_create."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Whimsical?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Whimsical in design-creative on the Manufact MCP catalog include Motion, MotionVid, Sleek, Streamloop MCP, and Image Generation."
      }
    },
    {
      "@type": "Question",
      "name": "Does Whimsical MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Whimsical requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Whimsical?",
      "acceptedAnswer": {
