  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Typeform to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Typeform to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.typeform.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Typeform MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Typeform lists 60 MCP tools, including accounts-list_accounts, automations-public_add_delay_step, automations-public_add_email_step, automations-public_add_integration_step, automations-public_add_webhook_step, automations-public_create_automation, automations-public_get_authorized_email_domains, automations-public_get_automation, automations-public_get_email_notification, automations-public_get_trigger, automations-public_list_automations, and automations-public_list_referenceable_fields."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Typeform?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Typeform in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Typeform MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Typeform requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
