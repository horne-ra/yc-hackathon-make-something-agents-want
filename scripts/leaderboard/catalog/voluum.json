  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Voluum to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Voluum to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.voluum.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Voluum MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Voluum lists 196 MCP tools, including any_affiliate_network_created, any_campaign_created, any_flow_created, any_lander_created, any_offer_created, any_traffic_source_created, archive_affiliate_networks, archive_campaigns, archive_flows, archive_landers, archive_offers, and archive_traffic_sources."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Voluum?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Voluum in marketing-seo on the Manufact MCP catalog include Buzzfy, Airefs AI Visibility, TalkGenAI, RankControl, and attentive-mcp-server."
      }
    },
    {
      "@type": "Question",
      "name": "Does Voluum MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Voluum requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Voluum?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Voluum is developed by Voluum. It is listed as partner on the Claude connector directory."
      }
    }
  ],
