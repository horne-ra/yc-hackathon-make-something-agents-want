  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Brizz to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Brizz to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://platform.brizz.dev/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Brizz MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Brizz lists 45 MCP tools, including brizz_aggregate_sessions, brizz_aggregate_tool_calls, brizz_aggregated_data_for_sessions, brizz_ask_agent, brizz_continue_agent_conversation, brizz_create_classification, brizz_delete_classification, brizz_describe_schema, brizz_download_report, brizz_edit_classification_labels, brizz_get_classification, and brizz_get_conversation."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Brizz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Brizz in data-analytics on the Manufact MCP catalog include Epicure, Newsflash, Point Topic, Pricing Optimizer AI, and StatCite."
      }
    },
    {
      "@type": "Question",
      "name": "Does Brizz MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Brizz requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
