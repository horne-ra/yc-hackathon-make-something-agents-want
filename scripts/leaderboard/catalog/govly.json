  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Govly to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Govly to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://app.govly.com/api/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Govly MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Govly lists 48 MCP tools, including add_workspace_member, create_award_saved_search, create_opportunity_saved_search, create_workspace, create_workspace_comment, document_download, document_read, execute_award_saved_search, fetch_opportunities, follow_entity, inbox_accept, and inbox_dismiss."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Govly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Govly in data-analytics on the Manufact MCP catalog include Epicure, Newsflash, Point Topic, Pricing Optimizer AI, and StatCite."
      }
    },
    {
      "@type": "Question",
      "name": "Does Govly MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Govly requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
