  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Ad Superpowers to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Ad Superpowers to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.adsuperpowers.ai/v1. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Ad Superpowers MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ad Superpowers lists 51 MCP tools, including clients, clients_update, ga4_list_properties, ga4_run_report, google_ads_list_accounts, google_ads_mutate, google_ads_run_gaql, google_ads_run_keyword_planner, gsc_list_sites, gsc_manage_url, gsc_search_analytics, and gtm_audit."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Ad Superpowers?",
      "acceptedAnswer": {
        "@type": "Answer",
