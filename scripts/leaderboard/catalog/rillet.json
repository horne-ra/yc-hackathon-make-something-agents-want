  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Rillet to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Rillet to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.rillet.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Rillet MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rillet lists 81 MCP tools, including amend_a_contract, apply_vendor_credit, create_a_bill, create_a_bill_payment, create_a_contract, create_a_credit_memo, create_a_customer, create_a_product, create_a_vendor, create_a_vendor_credit, create_an_invoice, and create_an_invoice_payment."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Rillet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Rillet in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does Rillet MCP require authentication?",
