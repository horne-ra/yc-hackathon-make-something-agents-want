  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Yodeck to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Yodeck to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.yodeck.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Yodeck MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yodeck lists 53 MCP tools, including completeMediaUpload, createGroup, createLayout, createMedia, createPlaylist, createRole, createSchedule, createScreen, createUser, createWorkspace, deleteResource, and getFolderByID."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Yodeck?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Yodeck in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Yodeck MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yodeck requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
