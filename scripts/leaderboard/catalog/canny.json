  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Canny to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Canny to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.canny.io/api/mcp/v1. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Canny MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Canny lists 61 MCP tools, including add_user_to_company, create_changelog_entry, create_company, create_group, create_idea, create_insight, create_portal_comment, create_user, create_view, delete_changelog_entry, delete_group, and delete_idea."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Canny?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Canny in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Canny MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Canny requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Canny?",
