  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Aleph to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Aleph to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.getaleph.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Aleph MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aleph lists 116 MCP tools, including append_rows, apply_template, clear_spreadsheet_range, compare_table_versions, delete_automation, delete_block, delete_calculated_item, delete_custom_skill, delete_dashboard_page, delete_dimension, delete_dimension_value, and delete_exchange_rate."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Aleph?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Aleph in data-analytics on the Manufact MCP catalog include Epicure, Newsflash, Point Topic, Pricing Optimizer AI, and StatCite."
      }
    },
    {
      "@type": "Question",
      "name": "Does Aleph MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aleph requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Aleph?",
