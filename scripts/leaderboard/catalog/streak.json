  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Streak to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Streak to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.streak.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Streak MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Streak lists 26 MCP tools, including add_call_log, add_thread_to_box, assign_box, create_box, create_comment, create_contact, create_organization, create_task, feedback, fetch, filter_boxes, and get_box."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Streak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Streak in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Streak MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Streak requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Streak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Streak is developed by Rewardly, Inc.. It is listed as community on the Claude connector directory."
      }
