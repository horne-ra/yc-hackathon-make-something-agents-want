  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Leadsquared to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Leadsquared to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp-server.pulseai-in21.leadsquared.com/mcp/v1. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Leadsquared MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Leadsquared lists 77 MCP tools, including create_a_lead, create_leads_in_bulk, create_or_update_a_lead, capture_leads, create_a_lead_and_activity_lead_management, create_a_note, get_a_lead_by_email, get_a_lead_by_phone_number, quick_search_leads, search_leads_by_criteria, get_metadata, and get_a_lead_field_s_properties."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Leadsquared?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Leadsquared in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Leadsquared MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Leadsquared requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
