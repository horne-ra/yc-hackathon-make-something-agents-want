  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Vendizap to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Vendizap to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api-docs.vendizap.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Vendizap MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vendizap lists 43 MCP tools, including create_category, create_product, create_product_combinations, create_product_variation, create_product_variation_value, create_progressive_discount, create_variation, create_variation_value, delete_product_variation, delete_product_variation_value, delete_progressive_discount, and get_category."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Vendizap?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Vendizap in commerce-shopping on the Manufact MCP catalog include EbooksDepository, ecoExperten Energieausweis, PHS Pallets, Promotion Pros Catalog, and RCO-A2A."
      }
    },
    {
      "@type": "Question",
      "name": "Does Vendizap MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vendizap requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
