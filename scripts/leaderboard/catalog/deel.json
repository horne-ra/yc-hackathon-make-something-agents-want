  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Deel to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Deel to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.letsdeel.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Deel MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Deel lists 95 MCP tools, including add_off_cycle_payment_for_contract, add_workflow_actions, add_workflow_trigger, amend_contract, calculate_employment_cost, calculate_employment_cost_for_multiple_countries, calculate_eor_versus_entity_hiring_costs, calculate_take_home_pay, cancel_time_off_request, check_visa_requirement, create_analytics_tile, and create_a_new_contract."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Deel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Deel in financial-services on the Manufact MCP catalog include Contract-Factory — Sociétés & SIREN, Kavara Kirk, CeylonCharts, Netzo, and Ramp Data."
      }
    },
    {
      "@type": "Question",
      "name": "Does Deel MCP require authentication?",
