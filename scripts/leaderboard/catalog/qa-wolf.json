  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add QA Wolf to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add QA Wolf to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://app.qawolf.com/api/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the QA Wolf MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "QA Wolf lists 49 MCP tools, including agent_get, agent_send, automate, email_find, email_get, email_getAttachment, email_listAddresses, email_send, environment_create, environment_deleteVariable, environment_find, and environment_get."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to QA Wolf?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to QA Wolf in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does QA Wolf MCP require authentication?",
