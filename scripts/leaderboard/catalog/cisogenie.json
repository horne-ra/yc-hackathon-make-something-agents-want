  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add CISOGenie to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add CISOGenie to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://portal.cisogenie.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the CISOGenie MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CISOGenie lists 79 MCP tools, including dashboard_get_breach_watch, dashboard_get_breach_watch_report, dashboard_get_cia_coverage, dashboard_get_compliance, dashboard_get_gap_assessment, dashboard_get_overview, dashboard_get_risk_severity, dashboard_get_risk_status, dashboard_get_risk_treatment, dashboard_get_risks, dashboard_get_security_functions, and dashboard_get_subscribed_compliance_overlap."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to CISOGenie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to CISOGenie in data-analytics on the Manufact MCP catalog include Epicure, Newsflash, Point Topic, Pricing Optimizer AI, and StatCite."
      }
    },
    {
      "@type": "Question",
      "name": "Does CISOGenie MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CISOGenie requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops CISOGenie?",
      "acceptedAnswer": {
