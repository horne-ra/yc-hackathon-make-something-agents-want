  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add VoIP.ms (Unofficial) to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add VoIP.ms (Unofficial) to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://voipms-mcp.ecliptical.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the VoIP.ms (Unofficial) MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoIP.ms (Unofficial) lists 224 MCP tools, including add_charge, add_lnp_file, add_lnp_port, add_member_to_conference, add_payment, assign_did_vpri, back_order_did_can, back_order_did_usa, cancel_did, cancel_fax_number, connect_did, and connect_fax."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to VoIP.ms (Unofficial)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to VoIP.ms (Unofficial) in communication on the Manufact MCP catalog include AgentLine: Phone Numbers for AI Agents, JooVoice, OpenMail, Granola, and Fleet Connected Apps."
      }
    },
    {
      "@type": "Question",
      "name": "Does VoIP.ms (Unofficial) MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "VoIP.ms (Unofficial) requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops VoIP.ms (Unofficial)?",
      "acceptedAnswer": {
