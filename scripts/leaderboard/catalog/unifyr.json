  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Unifyr to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Unifyr to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.unifyr.ai/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Unifyr MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unifyr lists 76 MCP tools, including add_deal_comment, add_deal_contact, approve_pending_partner, assign_leads_to_partner, check_account_duplicates, create_account, create_collateral, create_deal, create_partner, create_partner_communication, draft_email_campaign, and find_accounts."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Unifyr?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Unifyr in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Unifyr MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unifyr requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
