  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Conversion to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Conversion to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.conversion.ai/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Conversion MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Conversion lists 77 MCP tools, including contact_get, contact_list, contact_count, contact_create, contact_list_fields, contact_list_fields_verbose, contact_get_events, contact_get_automation_runs, contact_create_field, contact_get_distinct_field_values, contact_list_opportunities, and import_contacts_csv_upload."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Conversion?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Conversion in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Conversion MCP require authentication?",
