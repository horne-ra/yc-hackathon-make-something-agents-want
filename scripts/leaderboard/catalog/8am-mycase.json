  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add 8am MyCase to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add 8am MyCase to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.mycase.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the 8am MyCase MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "8am MyCase lists 73 MCP tools, including download_document, download_document_version, full_text_search, get_call, get_case, get_case_billing_summary, get_case_folder, get_case_invoice_line_items, get_case_stage, get_client, get_company, and get_custom_field."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to 8am MyCase?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to 8am MyCase in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does 8am MyCase MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "8am MyCase requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops 8am MyCase?",
