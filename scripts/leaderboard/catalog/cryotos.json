  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Cryotos to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Cryotos to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.cryotos.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Cryotos MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cryotos lists 40 MCP tools, including find_similar_assets, find_similar_locations, get_all_departments, get_all_project_budgets, get_all_states, get_all_tags, get_all_usergroups, get_all_users, get_asset_timeline_wise_downtime, get_asset_wise_downtime, get_assets_by_filter, and get_categories_by_filter."
      }
    },
    {
