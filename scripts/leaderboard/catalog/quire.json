  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Quire to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Quire to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.quire.app/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Quire MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Quire lists 96 MCP tools, including add_chat_comment, add_comment, add_comment_attachment, add_task_attachment, add_task_timelog, add_task_to_sublist, approve_task, bulk_approve_tasks, bulk_create_subtasks, bulk_create_tasks, bulk_delete_tasks, and bulk_move_tasks."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Quire?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Quire in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Quire MCP require authentication?",
