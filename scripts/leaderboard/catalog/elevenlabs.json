  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add ElevenLabs to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add ElevenLabs to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.elevenlabs.io/v1/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the ElevenLabs MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ElevenLabs lists 79 MCP tools, including agents_add_triage_ticket_comment, agents_add_triage_ticket_turn_comment, agents_bulk_delete_knowledge_base, agents_bulk_move_knowledge_base, agents_calculate_llm_usage, agents_compile_procedures, agents_create, agents_create_branch, agents_create_deployment, agents_create_draft, agents_create_kb_folder, and agents_create_kb_text."
      }
    },
