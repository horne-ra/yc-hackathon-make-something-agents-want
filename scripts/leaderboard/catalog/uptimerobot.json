  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add UptimeRobot to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add UptimeRobot to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.uptimerobot.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the UptimeRobot MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "UptimeRobot lists 32 MCP tools, including create-incident-comment, create-maintenance-window, create-monitor, create-monitor-group, create-psp, create-psp-announcement, get-incident-details, get-maintenance-window, get-monitor-details, get-monitor-group, get-monitor-stats, and get-psp."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to UptimeRobot?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to UptimeRobot in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does UptimeRobot MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "UptimeRobot requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops UptimeRobot?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "UptimeRobot is developed by UptimeRobot. It is listed as community on the Claude connector directory."
      }
