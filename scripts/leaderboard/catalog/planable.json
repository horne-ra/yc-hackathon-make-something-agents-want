  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Planable to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Planable to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.planable.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Planable MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Planable lists 48 MCP tools, including add_competitor, approve_post, assign_posts_to_campaign, create_campaign, create_comment, create_custom_view, create_grouped_post, create_label, create_post, delete_campaign, delete_custom_view, and disapprove_post."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Planable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Planable in marketing-seo on the Manufact MCP catalog include Buzzfy, Airefs AI Visibility, TalkGenAI, RankControl, and attentive-mcp-server."
      }
    },
    {
      "@type": "Question",
      "name": "Does Planable MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Planable requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
