  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add KANNA to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add KANNA to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.kanna4u.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the KANNA MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "KANNA lists 84 MCP tools, including blackboard_layout_patterns_find_all, blackboard_layouts_create, blackboard_layouts_find_all, blackboard_layouts_find_one, blackboards_create, blackboards_find_all, blackboards_find_one, blackboards_update, chats_create, chats_find_one, chats_update, and clients_create."
      }
    },
