  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Sanity to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Sanity to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.sanity.io/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Sanity MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sanity lists 31 MCP tools, including add_cors_origin, create_dataset, create_documents_from_json, create_documents_from_markdown, create_project, create_version, deploy_schema, discard_drafts, get_document, get_project_studios, get_sanity_rules, and get_schema."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Sanity?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Sanity in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
