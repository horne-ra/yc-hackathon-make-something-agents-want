  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add CompanyCam to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add CompanyCam to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://app.companycam.com/public_api/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the CompanyCam MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CompanyCam lists 71 MCP tools, including add_photo_description, add_project_to_group, archive_project, assign_user_to_project, comment_on_photo, comment_on_project, create_conditional_checklist_from_template, create_photo_upload, create_project, create_project_document, create_project_group, and create_project_invitation."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to CompanyCam?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to CompanyCam in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does CompanyCam MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CompanyCam requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops CompanyCam?",
