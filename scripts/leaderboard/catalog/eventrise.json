  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Eventrise to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Eventrise to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.eventrise.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Eventrise MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eventrise lists 120 MCP tools, including organization_add_session_speaker, organization_add_session_ticket, organization_approve_refund, organization_calculate_ticket_price, organization_cancel_order, organization_checkin_attendee, organization_checkin_order_item, organization_create_comped_order, organization_create_custom_question, organization_create_document, organization_create_event, and organization_create_featured_event."
      }
    },
