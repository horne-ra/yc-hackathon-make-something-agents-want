  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Tsuga to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Tsuga to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.tsuga.com/v0/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Tsuga MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tsuga lists 76 MCP tools, including aggregate-scalar, aggregate-timeseries, create-dashboard, create-feedback, create-ingestion-api-key, create-investigation, create-monitor, create-notification-rule, create-notification-silence, create-retention-policy, create-route, and create-tag-policy."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Tsuga?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Tsuga in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does Tsuga MCP require authentication?",
