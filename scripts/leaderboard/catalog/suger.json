  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Suger to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Suger to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://apiv2.suger.cloud/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Suger MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Suger lists 137 MCP tools, including AddContactToBuyer, AddContactToOffer, AddEntitlementCredit, AggregateUsageRecordGroups, AggregateUsageRecordReports, ApplyAddonToEntitlement, ApproveEntitlement, AzureInvitePartnerCollaboration, BatchCreateContacts, BatchCreateCosellReferrals, BatchReportUsageRecordGroups, and BatchValidateUsageRecordGroups."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Suger?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Suger in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Suger MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Suger requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Suger?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Suger is developed by Suger Inc.. It is listed as community on the Claude connector directory."
      }
    }
  ],
