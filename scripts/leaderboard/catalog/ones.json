  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add ONES to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add ONES to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://us.ones.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the ONES MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ONES lists 65 MCP tools, including add_manhour_estimated_in_summary_mode, add_project_members, add_workhour_in_simple_mode, add_workhour_in_summary_mode, create_module_in_testcase_library, create_new_issue, create_new_project, create_new_testcase_in_library, create_page, create_sprint, execute_issue_workflow, and find_similar_issues."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to ONES?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to ONES in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does ONES MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ONES requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
