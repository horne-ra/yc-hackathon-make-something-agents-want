  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Intelligems to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Intelligems to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://ai.intelligems.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Intelligems MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Intelligems lists 50 MCP tools, including analytics_agent, analyze_experience, commit_price_test_products, create_experience, datadog_analyze_datadog_logs, datadog_search_datadog_logs, experience_action, generate_custom_graph, generate_intelligems_graph, get_collection_products, get_event_snapshot, and get_event_timeseries."
      }
