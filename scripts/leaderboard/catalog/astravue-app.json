  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Astravue App to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Astravue App to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.astravue.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Astravue App MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Astravue App lists 83 MCP tools, including astravue_add_dependency, astravue_add_project_member, astravue_add_tag_to_task, astravue_add_task_comment, astravue_bulk_create_tags, astravue_bulk_create_tasks, astravue_bulk_delete_tasks, astravue_bulk_update_tasks, astravue_create_checklist_item, astravue_create_custom_field, astravue_create_custom_field_option, and astravue_create_filter."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Astravue App?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Astravue App in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Astravue App MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Astravue App requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
