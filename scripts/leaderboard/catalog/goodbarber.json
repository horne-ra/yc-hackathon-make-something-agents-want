  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add GoodBarber to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add GoodBarber to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.goodbarber.dev/mcp/sse. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the GoodBarber MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GoodBarber lists 120 MCP tools, including cms_create_article, cms_create_article_paragraph, cms_create_event, cms_create_event_paragraph, cms_create_map, cms_create_map_paragraph, cms_create_photos, cms_create_sound_paragraph, cms_create_video, cms_create_video_paragraph, cms_delete_article, and cms_delete_article_paragraph."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to GoodBarber?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to GoodBarber in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
