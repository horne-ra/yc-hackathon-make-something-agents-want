  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Wattwin to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Wattwin to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://ai.wattwin.com/api/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Wattwin MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wattwin lists 81 MCP tools, including find_contact_by_id, find_document_by_id, find_document_folder_by_code, find_document_folder_by_id, find_document_folders, find_document_template_by_id, find_document_templates, find_documents, find_ecommerce_order_by_id, find_flow_instance_by_id, find_note_reply_by_id, and find_pipeline_by_id."
      }
    },
