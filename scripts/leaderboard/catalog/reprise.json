  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Reprise to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Reprise to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://app.getreprise.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Reprise MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Reprise lists 83 MCP tools, including clone_debug_errors, clone_debug_routes, clone_debug_start, clone_debug_stop, clone_get, clone_list, clone_path_get, clone_request_analyze, clone_request_content, clone_request_content_write, clone_request_get, and clone_request_search."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Reprise?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Reprise in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Reprise MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Reprise requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Reprise?",
      "acceptedAnswer": {
