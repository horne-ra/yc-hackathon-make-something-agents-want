  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Frase to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Frase to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://next.frase.io/api/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Frase MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Frase lists 121 MCP tools, including analyze_competitors, analyze_serp, apply_ai_comment, apply_optimization, apply_template, assign_to_cluster, audit_page, batch_atomize, bulk_cms_posts, bulk_set_comment_status, cms_post, and create_atomization."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Frase?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Frase in marketing-seo on the Manufact MCP catalog include Buzzfy, Airefs AI Visibility, TalkGenAI, RankControl, and attentive-mcp-server."
      }
    },
    {
      "@type": "Question",
      "name": "Does Frase MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Frase requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
