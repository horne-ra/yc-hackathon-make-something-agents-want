  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Redox to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Redox to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.redoxengine.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Redox MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Redox lists 102 MCP tools, including create-alert-v2, create-config-modifier, create-destination, create-filter, create-filter-link, create-link, create-link-v2, create-oauth-key, create-source, create-source-link, create-source-portmap, and create-subscription."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Redox?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Redox in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does Redox MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Redox requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Redox?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Redox is developed by Redox Inc. It is listed as community on the Claude connector directory."
      }
