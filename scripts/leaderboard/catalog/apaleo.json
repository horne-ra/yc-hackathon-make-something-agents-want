  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Apaleo to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Apaleo to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.apaleo.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Apaleo MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Apaleo lists 206 MCP tools, including AddCityTax, AddReservationToBooking, AddReservationToGroup, AmendBlock, AmendReservation, ArchiveProperty, AssignSpecificUnit, AssignUnit, BookService, BulkMoveCharges, CancelBlock, and CancelInvoice."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Apaleo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Apaleo in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Apaleo MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Apaleo requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Apaleo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Apaleo is developed by Apaleo. It is listed as community on the Claude connector directory."
      }
    }
