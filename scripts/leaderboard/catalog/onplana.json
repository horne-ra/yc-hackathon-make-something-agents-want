  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Onplana to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Onplana to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.onplana.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Onplana MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Onplana lists 265 MCP tools, including add_ccb_member, add_project_member, add_project_to_portfolio, add_subtasks, add_timesheet_approver, advance_proposal_stage, agent_bootstrap, analyze_project_risks, append_log, approve_timesheet_entry, approve_timesheet_week, and assign_tag."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Onplana?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Onplana in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Onplana MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Onplana requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Onplana?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Onplana is developed by Devsoft Solutions. It is listed as community on the Claude connector directory."
      }
    }
  ],
