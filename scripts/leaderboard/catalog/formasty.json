  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Formasty to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Formasty to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://app.formasty.com/api/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Formasty MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Formasty lists 75 MCP tools, including formasty_add_field, formasty_add_step, formasty_apply_unsplash_image, formasty_audit_form, formasty_clone_form, formasty_configure_matching_rules, formasty_configure_quiz, formasty_configure_scheduler_provider, formasty_configure_score_calculation, formasty_configure_workflow_variables, formasty_create_ending_screen, and formasty_create_form."
      }
    },
