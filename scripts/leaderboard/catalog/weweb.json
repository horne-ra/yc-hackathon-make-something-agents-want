  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add WeWeb to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add WeWeb to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://ai-api.weweb.io/v1/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the WeWeb MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WeWeb lists 125 MCP tools, including activateIconSet, addElements, addRowToWeWebTable, addSection, addWeWebTableColumn, addWeWebTableConstraint, changeDefaultTheme, checkIconNames, createApiBackendWorkflow, createAppWorkflow, createClass, and createDesignSystemClass."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to WeWeb?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to WeWeb in developer-tools on the Manufact MCP catalog include Held at the Gate, Speko, turva.dev, AgentMail, and Celesto Cloud Computers."
      }
    },
    {
      "@type": "Question",
      "name": "Does WeWeb MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WeWeb requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops WeWeb?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WeWeb is developed by WeWeb. It is listed as partner on the Claude connector directory."
      }
    }
  ],
