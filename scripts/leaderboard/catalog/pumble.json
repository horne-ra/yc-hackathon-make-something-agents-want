  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Pumble to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Pumble to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.pumble.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Pumble MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pumble lists 19 MCP tools, including add_reaction_to_message, add_user_to_channel, create_call_link, create_channel, delete_scheduled_message, edit_message, fetch_file, get_channel_details, get_channel_messages, get_channels, get_latest_messages, and get_scheduled_messages."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Pumble?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Pumble in communication on the Manufact MCP catalog include AgentLine: Phone Numbers for AI Agents, JooVoice, OpenMail, Granola, and Fleet Connected Apps."
      }
