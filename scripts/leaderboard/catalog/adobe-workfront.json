  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Adobe Workfront to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Adobe Workfront to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.workfront.adobe.com/mcp/v1/workfront. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Adobe Workfront MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Adobe Workfront lists 68 MCP tools, including approvals_find_document_version_by_name, approvals_get_document_by_version_id, approvals_get_documents_by_project, approvals_resolve_document_scope, approvals_get_approval_info, approvals_create_or_update_approval_workflow, approvals_create_approval_from_template, approvals_delete_approval_stage, approvals_send_reminder_to_participants, approvals_send_reminder_to_undecided, approvals_list_templates, and approvals_search_template_by_name."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Adobe Workfront?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Adobe Workfront in productivity on the Manufact MCP catalog include Autodesk Product Help, BoardWise, FlagStat, Keenable Web Search, and PomoDial."
      }
    },
    {
      "@type": "Question",
      "name": "Does Adobe Workfront MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Adobe Workfront requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Adobe Workfront?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Adobe Workfront is developed by Adobe. It is listed as partner on the Claude connector directory."
      }
    }
