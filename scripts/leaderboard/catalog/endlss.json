  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Endlss to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Endlss to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.endlss.io/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Endlss MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Endlss lists 78 MCP tools, including endlss_activity_summary, endlss_analytics_overview, endlss_append_learned_observation, endlss_approve_sequence_response_draft, endlss_archive_sequence_enrollment, endlss_bulk_add_favorite_creators, endlss_bulk_delete_favorite_creators, endlss_bulk_invite, endlss_cancel_offer, endlss_capabilities, endlss_create_favorite_list, and endlss_create_invite."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Endlss?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Endlss in sales-and-marketing on the Manufact MCP catalog include Griddo AX Docs, Rocket Sloth, Affonso.io, Datacircle, and Tolt."
      }
    },
    {
      "@type": "Question",
      "name": "Does Endlss MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Endlss requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
