  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add SEOcrawl AI to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add SEOcrawl AI to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.seocrawl.ai/. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the SEOcrawl AI MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEOcrawl AI lists 85 MCP tools, including add_annotation, add_comment, add_task_follower, apply_tag, assign_task_to_milestone, compare_date_ranges, compare_ga4_date_ranges, compare_site_audit_crawls, create_milestone, create_prompt, create_prompt_topic, and create_smart_view."
      }
    },
