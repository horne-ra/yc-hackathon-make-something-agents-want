  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Tenzo AI to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Tenzo AI to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://api.tenzo.ai/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Tenzo AI MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tenzo AI lists 53 MCP tools, including get_analytics_metrics, get_application, get_application_by_candidate_and_job, get_application_communications_email, get_application_communications_sms, get_ats_integration_configuration, get_audit_event_filter_options, get_call, get_call_quality_eval, get_call_transcript, get_candidate, and get_candidate_resume."
      }
    },
    {
