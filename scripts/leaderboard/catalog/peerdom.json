  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Peerdom to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Peerdom to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.peerdom.org/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Peerdom MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Peerdom lists 42 MCP tools, including activate_apps, assign_holders, assign_holders_bulk, create_custom_fields, create_goal, create_groups, create_peers, create_project, create_roles, delete_custom_field, delete_goal, and delete_group."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Peerdom?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 18, 2026, alternatives to Peerdom in other on the Manufact MCP catalog include Muju, ZMAXINC, PGA – Play Golf, citytracker.ai, and Commonlands Optics: M12 Lens and C-Mount Lens Finder + Field-of-View Calculator."
      }
    },
    {
      "@type": "Question",
      "name": "Does Peerdom MCP require authentication?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Peerdom requires authentication. Connect it in Claude, ChatGPT, or Cursor and complete the OAuth login prompt."
      }
    },
    {
      "@type": "Question",
      "name": "Who develops Peerdom?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Peerdom is developed by Peerdom AG. It is listed as community on the Claude connector directory."
