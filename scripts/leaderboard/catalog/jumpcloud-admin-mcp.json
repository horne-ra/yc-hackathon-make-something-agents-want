  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add JumpCloud Admin MCP to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add JumpCloud Admin MCP to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.jumpcloud.com/v1. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the JumpCloud Admin MCP MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "JumpCloud Admin MCP lists 108 MCP tools, including access_request_get, access_requests_list, active_directories_list, active_directory_translation_rules_list, active_directory_translation_rules_preview, active_directory_translation_rules_recommendation, admin_get, admin_list, admin_reactivate, admin_reset_totp, admin_update, and alert_get."
      }
    },
    {
