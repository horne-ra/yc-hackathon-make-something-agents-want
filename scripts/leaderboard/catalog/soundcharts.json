  "_published_faq": [
    {
      "@type": "Question",
      "name": "How do I add Soundcharts to Claude, ChatGPT, or Cursor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Add Soundcharts to Claude, ChatGPT, or Cursor by connecting its remote MCP URL in each client's MCP settings. In Claude, add a custom connector. In ChatGPT, add an MCP app. In Cursor, add an MCP server under Settings. The MCP URL is https://mcp.soundcharts.com/mcp. This server requires OAuth, so complete the login prompt after you connect."
      }
    },
    {
      "@type": "Question",
      "name": "What tools does the Soundcharts MCP server provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Soundcharts lists 86 MCP tools, including discover_artists, discover_fast_growing_songs, discover_festivals, discover_playlists, discover_songs, discover_venues, find_songs_by_audience_size, get_album, get_album_links, get_album_tracks, get_artist, and get_artist_album_chart_positions."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best alternatives to Soundcharts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As of October 17, 2026, alternatives to Soundcharts in media-entertainment on the Manufact MCP catalog include Credits.fm, SceneF, HANKOOKILBO MCP, Ticketbox.vn, and drawnames."
      }
    },
