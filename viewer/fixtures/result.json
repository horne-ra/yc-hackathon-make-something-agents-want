        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "One of: open, in_progress, blocked, closed. open: not started. in_progress: someone is actively working on it. blocked: waiting on something. closed: done."
          },
          "assignee": {
            "type": "string"
          },
          "include_comments": {
            "type": "boolean",
            "description": "Include full comment threads, roughly 1 to 2K tokens per issue. Defaults to true. Set false when only titles and status are needed."
          },
          "limit": {
            "type": "number"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "search_issues",
