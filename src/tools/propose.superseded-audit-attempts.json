        {
          "op": "set_tool_description",
          "tool": "search_issues",
          "value": "Search issues by case-insensitive text match on title or body. Use when you have keywords; use list_issues to filter by status or assignee, and get_issue for one known ID. Has no status, assignee or limit filter, and returns all matches. Comments are included by default; set include_comments to false for smaller responses.",
          "finding_ids": [
            "F1"
          ]
        },
        {
          "op": "set_param_description",
          "tool": "get_issue",
          "value": "Exact issue ID, as in the id field of an issue (e.g. TRK-117). Matching is exact; an unknown ID returns an \"Issue not found\" error.",
